---
interface Props {
  className?: string;
  size?: number;
}

const { className = "", size = 520 } = Astro.props;
---

<div class={`cp-doodle-container relative select-none ${className}`}>
  <!-- Subtle ambient volumetric glow -->
  <div class="absolute -inset-2 bg-gradient-to-r from-[#8B5CF6]/20 via-[#2ED3FE]/15 to-transparent rounded-2xl blur-xl opacity-60 -z-10"></div>

  <svg
    viewBox="0 0 540 360"
    width={size}
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-auto filter drop-shadow-xl"
    aria-label="Competitive Programming & Algorithmic Rigor Editorial Illustration"
  >
    <defs>
      <linearGradient id="cpGlass" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="rgba(15, 23, 42, 0.92)" />
        <stop offset="100%" stop-color="rgba(10, 14, 26, 0.96)" />
      </linearGradient>

      <linearGradient id="cpAccent" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#8B5CF6" />
        <stop offset="100%" stop-color="#2ED3FE" />
      </linearGradient>

      <linearGradient id="cpEmerald" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#10B981" />
        <stop offset="100%" stop-color="#34D399" />
      </linearGradient>

      <pattern id="cpGrid" width="20" height="20" patternUnits="userSpaceOnUse">
        <circle cx="2" cy="2" r="0.75" fill="rgba(255, 255, 255, 0.05)" />
      </pattern>
    </defs>

    <!-- Main Outer Container Window -->
    <rect x="15" y="15" width="510" height="330" rx="16" fill="url(#cpGlass)" stroke="rgba(139, 92, 246, 0.3)" stroke-width="1.6" />
    <rect x="15" y="15" width="510" height="330" rx="16" fill="url(#cpGrid)" />
    <path d="M 15 54 L 525 54" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1.2" />

    <!-- Window Controls & Header -->
    <circle cx="36" cy="35" r="4.5" fill="#EF4444" />
    <circle cx="52" cy="35" r="4.5" fill="#F59E0B" />
    <circle cx="68" cy="35" r="4.5" fill="#10B981" />

    <!-- Terminal Title -->
    <text x="92" y="39" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="700" fill="#E2E8F0">
      judge://codeforces.round.982/problem/F.cpp
    </text>

    <!-- Verdict Pill (Top Right) -->
    <g transform="translate(400, 24)">
      <rect x="0" y="0" width="112" height="22" rx="5" fill="rgba(16, 185, 129, 0.16)" stroke="#10B981" stroke-width="1" />
      <circle cx="12" cy="11" r="3.5" fill="#34D399" class="animate-pulse" />
      <text x="22" y="15" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#34D399">ACCEPTED (0.04s)</text>
    </g>

    <!-- ========================================== -->
    <!-- LEFT PANEL: SEGMENT TREE & GRAPH DISCOVERY -->
    <!-- ========================================== -->
    <!-- Tree Sub-Window Panel -->
    <rect x="30" y="68" width="310" height="195" rx="10" fill="rgba(255, 255, 255, 0.02)" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1" />

    <!-- Tree Panel Header -->
    <text x="44" y="86" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#8B5CF6">
      SEGMENT_TREE &lt;Lazy&gt; // RANGE_SUM_QUERY
    </text>
    <text x="250" y="86" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#64748B">
      query(2, 6) = 42
    </text>

    <!-- Branch Lines Connecting Tree -->
    <!-- Root to Level 1 -->
    <line x1="185" y1="122" x2="115" y2="152" stroke="#8B5CF6" stroke-width="1.8" stroke-dasharray="2 2" />
    <line x1="185" y1="122" x2="255" y2="152" stroke="#2ED3FE" stroke-width="2" />

    <!-- Level 1 to Level 2 (Left Branch) -->
    <line x1="115" y1="172" x2="75" y2="206" stroke="rgba(255, 255, 255, 0.2)" stroke-width="1.2" />
    <line x1="115" y1="172" x2="155" y2="206" stroke="#8B5CF6" stroke-width="1.6" />

    <!-- Level 1 to Level 2 (Right Branch - Active Query Path) -->
    <line x1="255" y1="172" x2="215" y2="206" stroke="#2ED3FE" stroke-width="2" />
    <line x1="255" y1="172" x2="295" y2="206" stroke="#10B981" stroke-width="2" />

    <!-- Level 0: Root Node [0..7] -->
    <circle cx="185" cy="112" r="16" fill="#0B0F19" stroke="#8B5CF6" stroke-width="2.2" />
    <text x="185" y="115" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="700" fill="#FFFFFF" text-anchor="middle">98</text>
    <text x="185" y="138" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#A78BFA" text-anchor="middle">[0..7]</text>

    <!-- Level 1: Left Node [0..3] -->
    <circle cx="115" cy="162" r="13" fill="#0B0F19" stroke="rgba(255, 255, 255, 0.3)" stroke-width="1.4" />
    <text x="115" y="165" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#94A3B8" text-anchor="middle">56</text>
    <text x="115" y="184" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#64748B" text-anchor="middle">[0..3]</text>

    <!-- Level 1: Right Node [4..7] (Highlighted in Query) -->
    <circle cx="255" cy="162" r="14" fill="rgba(46, 211, 254, 0.15)" stroke="#2ED3FE" stroke-width="2" />
    <text x="255" y="165" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#2ED3FE" text-anchor="middle">42</text>
    <text x="255" y="186" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#38BDF8" text-anchor="middle">[4..7] ✦</text>

    <!-- Level 2: Leaves -->
    <circle cx="75" cy="216" r="10" fill="#0B0F19" stroke="rgba(255, 255, 255, 0.15)" stroke-width="1" />
    <text x="75" y="219" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#64748B" text-anchor="middle">24</text>

    <circle cx="155" cy="216" r="10" fill="#0B0F19" stroke="#8B5CF6" stroke-width="1.2" />
    <text x="155" y="219" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#C084FC" text-anchor="middle">32</text>

    <!-- Target Nodes (Query hit [4..5] and [6..7]) -->
    <circle cx="215" cy="216" r="11" fill="rgba(46, 211, 254, 0.2)" stroke="#2ED3FE" stroke-width="1.8" />
    <text x="215" y="219" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#2ED3FE" text-anchor="middle">19</text>

    <circle cx="295" cy="216" r="11" fill="rgba(16, 185, 129, 0.2)" stroke="#10B981" stroke-width="1.8" />
    <text x="295" y="219" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#34D399" text-anchor="middle">23</text>

    <!-- Hand-drawn style Callout Arrow pointing to Tree Root -->
    <path d="M 60 115 Q 110 100, 160 110" stroke="#F59E0B" stroke-width="1.4" stroke-dasharray="3 3" fill="none" marker-end="url(#cpArrow)" />
    <text x="50" y="112" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="700" fill="#FBBF24">O(log N) lookup</text>

    <!-- ========================================== -->
    <!-- BOTTOM TAPE: DP ARRAY & RECURSION MEMORY   -->
    <!-- ========================================== -->
    <rect x="30" y="272" width="310" height="58" rx="8" fill="#07090E" stroke="rgba(46, 211, 254, 0.25)" stroke-width="1.2" />
    <text x="42" y="288" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#38BDF8">
      DP_TABLE // TRANSITION: dp[i] = min(dp[i-1], dp[i-k]) + cost[i]
    </text>

    <!-- Array Cells -->
    <g transform="translate(42, 296)">
      <!-- Cell 0 -->
      <rect x="0" y="0" width="36" height="24" rx="3" fill="rgba(255, 255, 255, 0.04)" stroke="rgba(255, 255, 255, 0.1)" stroke-width="1" />
      <text x="18" y="15" font-family="'JetBrains Mono', monospace" font-size="8.5" fill="#94A3B8" text-anchor="middle">0</text>
      <!-- Cell 1 -->
      <rect x="42" y="0" width="36" height="24" rx="3" fill="rgba(255, 255, 255, 0.04)" stroke="rgba(255, 255, 255, 0.1)" stroke-width="1" />
      <text x="60" y="15" font-family="'JetBrains Mono', monospace" font-size="8.5" fill="#94A3B8" text-anchor="middle">4</text>
      <!-- Cell 2 -->
      <rect x="84" y="0" width="36" height="24" rx="3" fill="rgba(255, 255, 255, 0.04)" stroke="rgba(255, 255, 255, 0.1)" stroke-width="1" />
      <text x="102" y="15" font-family="'JetBrains Mono', monospace" font-size="8.5" fill="#94A3B8" text-anchor="middle">7</text>
      <!-- Cell 3 (Active) -->
      <rect x="126" y="0" width="36" height="24" rx="3" fill="rgba(139, 92, 246, 0.25)" stroke="#8B5CF6" stroke-width="1.4" />
      <text x="144" y="15" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#C084FC" text-anchor="middle">12</text>
      <!-- Cell 4 (Optimal) -->
      <rect x="168" y="0" width="36" height="24" rx="3" fill="rgba(46, 211, 254, 0.2)" stroke="#2ED3FE" stroke-width="1.4" />
      <text x="186" y="15" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#2ED3FE" text-anchor="middle">15</text>
      <!-- Cell 5 (Optimal Global) -->
      <rect x="210" y="0" width="46" height="24" rx="3" fill="rgba(16, 185, 129, 0.25)" stroke="#10B981" stroke-width="1.6" />
      <text x="233" y="15" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#34D399" text-anchor="middle">19 ★</text>
      <!-- Cell 6 (Pending) -->
      <rect x="262" y="0" width="24" height="24" rx="3" fill="rgba(255, 255, 255, 0.02)" stroke="rgba(255, 255, 255, 0.06)" stroke-dasharray="2 2" />
      <text x="274" y="15" font-family="'JetBrains Mono', monospace" font-size="8.5" fill="#475569" text-anchor="middle">...</text>
    </g>

    <!-- ========================================== -->
    <!-- RIGHT PANEL: ALGORITHM TELEMETRY & STATS  -->
    <!-- ========================================== -->
    <!-- Big-O Caliper Card -->
    <rect x="355" y="68" width="155" height="74" rx="8" fill="rgba(255, 255, 255, 0.02)" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1" />
    <text x="368" y="85" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="700" fill="#94A3B8">TIME COMPLEXITY</text>
    <text x="368" y="112" font-family="'JetBrains Mono', monospace" font-size="20" font-weight="800" fill="#2ED3FE">O(N log N)</text>
    <text x="368" y="130" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#64748B">Space: O(N) auxiliary</text>

    <!-- ICPC Contest Telemetry -->
    <rect x="355" y="152" width="155" height="110" rx="8" fill="rgba(255, 255, 255, 0.02)" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1" />
    <text x="368" y="169" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="700" fill="#8B5CF6">CONTEST TELEMETRY</text>

    <!-- Metric Rows -->
    <text x="368" y="190" font-family="'JetBrains Mono', monospace" font-size="8" fill="#94A3B8">Passed Cases:</text>
    <text x="495" y="190" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#34D399" text-anchor="end">84 / 84</text>

    <text x="368" y="208" font-family="'JetBrains Mono', monospace" font-size="8" fill="#94A3B8">Memory Peak:</text>
    <text x="495" y="208" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#E2E8F0" text-anchor="end">2.4 MB</text>

    <text x="368" y="226" font-family="'JetBrains Mono', monospace" font-size="8" fill="#94A3B8">CPU Runtime:</text>
    <text x="495" y="226" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#38BDF8" text-anchor="end">38 ms</text>

    <text x="368" y="244" font-family="'JetBrains Mono', monospace" font-size="8" fill="#94A3B8">Rank Delta:</text>
    <text x="495" y="244" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#F59E0B" text-anchor="end">▲ +142 pts</text>

    <!-- Codeforces Candidate Master Badge -->
    <rect x="355" y="272" width="155" height="58" rx="8" fill="rgba(139, 92, 246, 0.12)" stroke="rgba(139, 92, 246, 0.4)" stroke-width="1.2" />
    <circle cx="372" cy="301" r="9" fill="#8B5CF6" />
    <text x="372" y="304" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="800" fill="#FFFFFF" text-anchor="middle">CF</text>
    <text x="390" y="296" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#C084FC">CANDIDATE MASTER</text>
    <text x="390" y="310" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#94A3B8">Max Rating: 1940+</text>
  </svg>
</div>
