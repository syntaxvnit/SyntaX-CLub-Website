---
interface Props {
  category?: string;
  slug?: string;
  className?: string;
}

const { category = "Workshop", slug = "", className = "" } = Astro.props;

// Determine theme based on category or slug
const isHackathon = category === "Hackathon" || slug.includes("hack");
const isCP = category === "CP Contest" || slug.includes("contest") || slug.includes("syntax");
const isAI = category === "AI Bootcamp" || slug.includes("rag") || slug.includes("llm") || slug.includes("agent");
---

<div class={`event-poster-wrapper relative w-full overflow-hidden rounded-xl bg-[#07090E] border border-white/10 select-none ${className}`}>
  <!-- Subtle ambient glow -->
  <div class="absolute inset-0 bg-gradient-to-t from-[#0B0F19] via-transparent to-transparent z-10 pointer-events-none"></div>

  {isHackathon ? (
    <svg viewBox="0 0 400 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto filter drop-shadow-md">
      <defs>
        <linearGradient id="hackGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#18112C" />
          <stop offset="100%" stop-color="#0F172A" />
        </linearGradient>
      </defs>
      <rect width="400" height="200" fill="url(#hackGrad)" />
      
      <!-- Grid pattern -->
      <path d="M0 40 H400 M0 80 H400 M0 120 H400 M0 160 H400" stroke="rgba(255,255,255,0.03)" stroke-width="1" />
      <path d="M80 0 V200 M160 0 V200 M240 0 V200 M320 0 V200" stroke="rgba(255,255,255,0.03)" stroke-width="1" />

      <!-- Glowing Circuit Traces -->
      <path d="M 20 100 H 120 L 150 70 H 260 L 290 110 H 380" stroke="#8B5CF6" stroke-width="1.8" stroke-dasharray="3 3" />
      <path d="M 40 140 H 140 L 170 170 H 300 L 330 130 H 380" stroke="#2ED3FE" stroke-width="1.8" />

      <!-- Center Hackathon Terminal & Countdown -->
      <g transform="translate(110, 45)">
        <rect x="0" y="0" width="180" height="110" rx="8" fill="#0B0F19" stroke="rgba(139, 92, 246, 0.4)" stroke-width="1.6" />
        <rect x="0" y="0" width="180" height="22" rx="8" fill="rgba(255,255,255,0.04)" />
        <circle cx="12" cy="11" r="3" fill="#EF4444" />
        <circle cx="22" cy="11" r="3" fill="#F59E0B" />
        <circle cx="32" cy="11" r="3" fill="#10B981" />
        <text x="45" y="14" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#94A3B8">synhack.arena // 36:00:00</text>

        <!-- Live Code lines -->
        <rect x="15" y="34" width="70" height="5" rx="1.5" fill="#2ED3FE" />
        <rect x="15" y="44" width="110" height="4" rx="1.5" fill="#64748B" />
        <rect x="15" y="52" width="90" height="4" rx="1.5" fill="#64748B" />
        <rect x="15" y="60" width="60" height="4" rx="1.5" fill="#C084FC" />
        <rect x="15" y="70" width="130" height="4" rx="1.5" fill="rgba(255,255,255,0.2)" />

        <!-- 36H Countdown Badge -->
        <rect x="15" y="82" width="150" height="18" rx="4" fill="rgba(245, 158, 11, 0.15)" stroke="#F59E0B" stroke-width="1" />
        <text x="90" y="94" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#FBBF24" text-anchor="middle">★ 36H IN-PERSON CLASH</text>
      </g>

      <!-- Steaming Mug (Left) -->
      <g transform="translate(45, 110)">
        <rect x="0" y="10" width="28" height="34" rx="4" fill="#0E131F" stroke="#FFFFFF" stroke-width="1.4" />
        <path d="M 28 16 C 36 16, 36 30, 28 30" stroke="#FFFFFF" stroke-width="1.4" fill="none" />
        <path d="M 8 5 Q 12 0, 8 -4" stroke="rgba(255,255,255,0.5)" stroke-width="1.2" fill="none" />
        <path d="M 16 5 Q 20 0, 16 -4" stroke="rgba(255,255,255,0.5)" stroke-width="1.2" fill="none" />
        <text x="6" y="28" font-family="'JetBrains Mono', monospace" font-size="6.5" font-weight="700" fill="#2ED3FE">CAFF</text>
      </g>

      <!-- Trophy Laurels (Right) -->
      <g transform="translate(325, 95)">
        <path d="M 10 10 H 38 L 34 32 C 32 38, 16 38, 14 32 Z" fill="rgba(245, 158, 11, 0.3)" stroke="#F59E0B" stroke-width="1.5" />
        <path d="M 10 14 C 2 14, 2 24, 11 25" stroke="#F59E0B" stroke-width="1.2" fill="none" />
        <path d="M 38 14 C 46 14, 46 24, 37 25" stroke="#F59E0B" stroke-width="1.2" fill="none" />
        <rect x="21" y="38" width="6" height="8" fill="#F59E0B" />
        <rect x="14" y="46" width="20" height="5" rx="1.5" fill="#334155" stroke="#F59E0B" stroke-width="1" />
        <text x="24" y="26" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="800" fill="#FBBF24" text-anchor="middle">#1</text>
      </g>
    </svg>
  ) : isCP ? (
    <svg viewBox="0 0 400 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto filter drop-shadow-md">
      <defs>
        <linearGradient id="cpGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#140E24" />
          <stop offset="100%" stop-color="#0A0E1A" />
        </linearGradient>
      </defs>
      <rect width="400" height="200" fill="url(#cpGrad)" />
      
      <!-- Graph & Segment Tree Network -->
      <!-- Tree connections -->
      <line x1="200" y1="45" x2="130" y2="85" stroke="#8B5CF6" stroke-width="1.8" />
      <line x1="200" y1="45" x2="270" y2="85" stroke="#2ED3FE" stroke-width="2" />
      <line x1="130" y1="85" x2="90" y2="135" stroke="rgba(255,255,255,0.2)" stroke-width="1.2" stroke-dasharray="2 2" />
      <line x1="130" y1="85" x2="160" y2="135" stroke="#8B5CF6" stroke-width="1.5" />
      <line x1="270" y1="85" x2="240" y2="135" stroke="#2ED3FE" stroke-width="1.8" />
      <line x1="270" y1="85" x2="310" y2="135" stroke="#10B981" stroke-width="2" />

      <!-- Root Node -->
      <circle cx="200" cy="45" r="14" fill="#0B0F19" stroke="#8B5CF6" stroke-width="2" />
      <text x="200" y="48" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#FFFFFF" text-anchor="middle">root</text>

      <!-- Level 1 Nodes -->
      <circle cx="130" cy="85" r="11" fill="#0B0F19" stroke="#8B5CF6" stroke-width="1.6" />
      <text x="130" y="88" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#C084FC" text-anchor="middle">2L</text>

      <circle cx="270" cy="85" r="12" fill="rgba(46, 211, 254, 0.2)" stroke="#2ED3FE" stroke-width="2" />
      <text x="270" y="88" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#2ED3FE" text-anchor="middle">2R</text>

      <!-- Leaves -->
      <circle cx="90" cy="135" r="9" fill="#0B0F19" stroke="rgba(255,255,255,0.2)" stroke-width="1" />
      <text x="90" y="138" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#64748B" text-anchor="middle">4</text>

      <circle cx="160" cy="135" r="9" fill="#0B0F19" stroke="#8B5CF6" stroke-width="1.2" />
      <text x="160" y="138" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#C084FC" text-anchor="middle">7</text>

      <circle cx="240" cy="135" r="10" fill="rgba(46, 211, 254, 0.2)" stroke="#2ED3FE" stroke-width="1.6" />
      <text x="240" y="138" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="700" fill="#2ED3FE" text-anchor="middle">12</text>

      <circle cx="310" cy="135" r="11" fill="rgba(16, 185, 129, 0.25)" stroke="#10B981" stroke-width="2" />
      <text x="310" y="138" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="700" fill="#34D399" text-anchor="middle">19★</text>

      <!-- Verdict Pill Banner -->
      <g transform="translate(25, 25)">
        <rect x="0" y="0" width="115" height="34" rx="6" fill="#0B0F19" stroke="#10B981" stroke-width="1.2" />
        <circle cx="14" cy="17" r="4" fill="#10B981" class="animate-pulse" />
        <text x="25" y="15" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#34D399">ACCEPTED</text>
        <text x="25" y="27" font-family="'JetBrains Mono', monospace" font-size="7" fill="#64748B">0.03s · 1.8MB</text>
      </g>

      <!-- Big O Complexity -->
      <g transform="translate(290, 25)">
        <rect x="0" y="0" width="85" height="34" rx="6" fill="#0B0F19" stroke="#2ED3FE" stroke-width="1.2" />
        <text x="42" y="15" font-family="'JetBrains Mono', monospace" font-size="7" fill="#64748B" text-anchor="middle">COMPLEXITY</text>
        <text x="42" y="28" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="700" fill="#2ED3FE" text-anchor="middle">O(N log N)</text>
      </g>

      <!-- Bottom Tape DP -->
      <g transform="translate(60, 165)">
        <rect x="0" y="0" width="280" height="22" rx="4" fill="#07090E" stroke="rgba(255,255,255,0.1)" stroke-width="1" />
        <text x="140" y="15" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#38BDF8" text-anchor="middle">dp[i] = min(dp[i-1], dp[i-2]) + cost[i]</text>
      </g>
    </svg>
  ) : isAI ? (
    <svg viewBox="0 0 400 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto filter drop-shadow-md">
      <defs>
        <linearGradient id="aiGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#0F172A" />
          <stop offset="100%" stop-color="#141E33" />
        </linearGradient>
      </defs>
      <rect width="400" height="200" fill="url(#aiGrad)" />

      <!-- Synaptic Network Lines -->
      <line x1="50" y1="50" x2="130" y2="70" stroke="rgba(46, 211, 254, 0.4)" stroke-width="1.4" />
      <line x1="50" y1="100" x2="130" y2="70" stroke="#2ED3FE" stroke-width="2" />
      <line x1="50" y1="100" x2="130" y2="130" stroke="#8B5CF6" stroke-width="2" />
      <line x1="50" y1="150" x2="130" y2="130" stroke="rgba(139, 92, 246, 0.4)" stroke-width="1.4" />

      <line x1="130" y1="70" x2="210" y2="100" stroke="#2ED3FE" stroke-width="2.2" />
      <line x1="130" y1="130" x2="210" y2="100" stroke="#8B5CF6" stroke-width="2.2" />

      <!-- Nodes -->
      <circle cx="50" cy="50" r="8" fill="#0B0F19" stroke="#38BDF8" stroke-width="1.8" />
      <circle cx="50" cy="100" r="8" fill="#0B0F19" stroke="#38BDF8" stroke-width="1.8" />
      <circle cx="50" cy="150" r="8" fill="#0B0F19" stroke="#38BDF8" stroke-width="1.8" />

      <circle cx="130" cy="70" r="10" fill="rgba(46, 211, 254, 0.2)" stroke="#2ED3FE" stroke-width="2" />
      <circle cx="130" cy="130" r="10" fill="rgba(139, 92, 246, 0.2)" stroke="#8B5CF6" stroke-width="2" />

      <circle cx="210" cy="100" r="15" fill="#0B0F19" stroke="#10B981" stroke-width="2.2" />
      <circle cx="210" cy="100" r="6" fill="#34D399" class="animate-pulse" />

      <!-- Attention Heatmap (Right) -->
      <g transform="translate(260, 40)">
        <rect x="0" y="0" width="115" height="115" rx="8" fill="#0B0F19" stroke="rgba(46, 211, 254, 0.3)" stroke-width="1.2" />
        <text x="10" y="16" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="700" fill="#2ED3FE">ATTENTION MATRIX</text>
        
        <g transform="translate(15, 26)">
          <rect x="0" y="0" width="18" height="18" rx="2" fill="rgba(46, 211, 254, 0.9)" />
          <rect x="22" y="0" width="18" height="18" rx="2" fill="rgba(46, 211, 254, 0.3)" />
          <rect x="44" y="0" width="18" height="18" rx="2" fill="rgba(139, 92, 246, 0.2)" />
          <rect x="66" y="0" width="18" height="18" rx="2" fill="rgba(46, 211, 254, 0.1)" />

          <rect x="0" y="20" width="18" height="18" rx="2" fill="rgba(46, 211, 254, 0.2)" />
          <rect x="22" y="20" width="18" height="18" rx="2" fill="rgba(139, 92, 246, 0.95)" />
          <rect x="44" y="20" width="18" height="18" rx="2" fill="rgba(46, 211, 254, 0.4)" />
          <rect x="66" y="20" width="18" height="18" rx="2" fill="rgba(139, 92, 246, 0.2)" />

          <rect x="0" y="40" width="18" height="18" rx="2" fill="rgba(139, 92, 246, 0.1)" />
          <rect x="22" y="40" width="18" height="18" rx="2" fill="rgba(46, 211, 254, 0.4)" />
          <rect x="44" y="40" width="18" height="18" rx="2" fill="rgba(46, 211, 254, 0.9)" />
          <rect x="66" y="40" width="18" height="18" rx="2" fill="rgba(139, 92, 246, 0.3)" />

          <rect x="0" y="60" width="18" height="18" rx="2" fill="rgba(46, 211, 254, 0.1)" />
          <rect x="22" y="60" width="18" height="18" rx="2" fill="rgba(139, 92, 246, 0.2)" />
          <rect x="44" y="60" width="18" height="18" rx="2" fill="rgba(46, 211, 254, 0.4)" />
          <rect x="66" y="60" width="18" height="18" rx="2" fill="rgba(16, 185, 129, 0.9)" />
        </g>
      </g>

      <!-- Token RAG tag -->
      <g transform="translate(60, 165)">
        <rect x="0" y="0" width="280" height="22" rx="4" fill="#07090E" stroke="rgba(255,255,255,0.1)" stroke-width="1" />
        <text x="140" y="15" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#34D399" text-anchor="middle">&gt; RAG_CONTEXT::RETRIEVE(top_k=5) · ON-DEVICE SLM</text>
      </g>
    </svg>
  ) : (
    <svg viewBox="0 0 400 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto filter drop-shadow-md">
      <defs>
        <linearGradient id="wsGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#0A1224" />
          <stop offset="100%" stop-color="#07090E" />
        </linearGradient>
      </defs>
      <rect width="400" height="200" fill="url(#wsGrad)" />

      <!-- Outer Browser Outline -->
      <g transform="translate(30, 20)">
        <rect x="0" y="0" width="340" height="160" rx="10" fill="#0B0F19" stroke="rgba(46, 211, 254, 0.3)" stroke-width="1.4" />
        <path d="M 0 30 L 340 30" stroke="rgba(255,255,255,0.08)" stroke-width="1" />
        <circle cx="16" cy="15" r="3.5" fill="#EF4444" />
        <circle cx="28" cy="15" r="3.5" fill="#F59E0B" />
        <circle cx="40" cy="15" r="3.5" fill="#10B981" />

        <rect x="60" y="8" width="180" height="15" rx="3" fill="rgba(255,255,255,0.04)" />
        <text x="70" y="19" font-family="'JetBrains Mono', monospace" font-size="7" fill="#38BDF8">https://syntax.vnit/workshop</text>

        <rect x="250" y="8" width="75" height="15" rx="3" fill="rgba(16, 185, 129, 0.15)" stroke="#10B981" stroke-width="0.8" />
        <text x="287" y="19" font-family="'JetBrains Mono', monospace" font-size="6.5" font-weight="700" fill="#34D399" text-anchor="middle">⚡ 100/100</text>

        <!-- Viewport code content -->
        <rect x="20" y="45" width="140" height="50" rx="6" fill="rgba(255,255,255,0.02)" stroke="rgba(255,255,255,0.05)" />
        <text x="30" y="62" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#FFFFFF">&lt;Island client:load /&gt;</text>
        <rect x="30" y="70" width="90" height="4" rx="1" fill="#64748B" />
        <rect x="30" y="78" width="60" height="4" rx="1" fill="#475569" />

        <!-- Git Commit Branch (Right) -->
        <g transform="translate(180, 45)">
          <line x1="20" y1="15" x2="20" y2="90" stroke="#8B5CF6" stroke-width="2" />
          <circle cx="20" cy="20" r="5" fill="#8B5CF6" />
          <circle cx="20" cy="55" r="5" fill="#2ED3FE" />
          <circle cx="20" cy="85" r="5" fill="#10B981" />

          <!-- Branch curve -->
          <path d="M 20 20 C 50 20, 50 55, 75 55" stroke="#2ED3FE" stroke-width="1.8" fill="none" />
          <circle cx="75" cy="55" r="4" fill="#2ED3FE" />

          <text x="32" y="24" font-family="'JetBrains Mono', monospace" font-size="7" fill="#E2E8F0">init main</text>
          <text x="85" y="58" font-family="'JetBrains Mono', monospace" font-size="7" fill="#38BDF8">feat: edge-api</text>
          <text x="32" y="88" font-family="'JetBrains Mono', monospace" font-size="7" fill="#34D399">release v1.0</text>
        </g>

        <!-- Bottom Terminal command -->
        <rect x="20" y="105" width="140" height="40" rx="4" fill="#07090E" stroke="rgba(46, 211, 254, 0.25)" stroke-width="1" />
        <text x="30" y="122" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="700" fill="#2ED3FE">$ git push origin</text>
        <text x="30" y="134" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#10B981">✓ Deployed to edge (12ms)</text>
      </g>
    </svg>
  )}
</div>
