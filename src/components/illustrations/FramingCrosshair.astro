---
interface Props {
  className?: string;
  color?: string;
}

const { className = "", color = "#2ED3FE" } = Astro.props;
---

<div class={`framing-crosshairs pointer-events-none absolute inset-0 overflow-hidden ${className}`}>
  <!-- Top Left Corner Bracket -->
  <svg class="absolute top-2 left-2 w-4 h-4" viewBox="0 0 16 16" fill="none">
    <path d="M 0 10 L 0 0 L 10 0" stroke={color} stroke-width="1.4" stroke-opacity="0.5" />
    <circle cx="0" cy="0" r="1.5" fill={color} />
  </svg>

  <!-- Top Right Corner Bracket -->
  <svg class="absolute top-2 right-2 w-4 h-4" viewBox="0 0 16 16" fill="none">
    <path d="M 16 10 L 16 0 L 6 0" stroke={color} stroke-width="1.4" stroke-opacity="0.5" />
    <circle cx="16" cy="0" r="1.5" fill={color} />
  </svg>

  <!-- Bottom Left Corner Bracket -->
  <svg class="absolute bottom-2 left-2 w-4 h-4" viewBox="0 0 16 16" fill="none">
    <path d="M 0 6 L 0 16 L 10 16" stroke={color} stroke-width="1.4" stroke-opacity="0.5" />
    <circle cx="0" cy="16" r="1.5" fill={color} />
  </svg>

  <!-- Bottom Right Corner Bracket -->
  <svg class="absolute bottom-2 right-2 w-4 h-4" viewBox="0 0 16 16" fill="none">
    <path d="M 16 6 L 16 16 L 6 16" stroke={color} stroke-width="1.4" stroke-opacity="0.5" />
    <circle cx="16" cy="16" r="1.5" fill={color} />
  </svg>

  <!-- Faint Circuit Node Trace in Background -->
  <svg class="absolute -bottom-4 -right-4 w-28 h-28 opacity-[0.07]" viewBox="0 0 100 100" fill="none">
    <path d="M 20 80 H 60 L 80 60 V 20" stroke="#FFFFFF" stroke-width="1.5" />
    <circle cx="80" cy="20" r="4" fill="#2ED3FE" />
    <circle cx="20" cy="80" r="3" fill="#0284C7" />
    <circle cx="60" cy="80" r="2.5" fill="#FFFFFF" />
  </svg>
</div>
