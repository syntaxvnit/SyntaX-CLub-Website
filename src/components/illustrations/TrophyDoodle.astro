---
interface Props {
  className?: string;
  size?: number;
}

const { className = "", size = 480 } = Astro.props;
---

<div class={`trophy-doodle-container relative select-none ${className}`}>
  <!-- Ambient golden/cyan championship glow -->
  <div class="absolute -inset-2 bg-gradient-to-r from-[#F59E0B]/20 via-[#2ED3FE]/15 to-[#8B5CF6]/15 rounded-2xl blur-xl opacity-60 -z-10"></div>

  <svg
    viewBox="0 0 520 340"
    width={size}
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-auto filter drop-shadow-xl"
    aria-label="SyntaX VNIT Championship Culture & Competition Laurels"
  >
    <defs>
      <linearGradient id="trophyGlass" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="rgba(15, 23, 42, 0.94)" />
        <stop offset="100%" stop-color="rgba(10, 14, 26, 0.98)" />
      </linearGradient>

      <linearGradient id="goldChampionship" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#FEF08A" />
        <stop offset="35%" stop-color="#F59E0B" />
        <stop offset="70%" stop-color="#D97706" />
        <stop offset="100%" stop-color="#92400E" />
      </linearGradient>

      <linearGradient id="silverMedal" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#FFFFFF" />
        <stop offset="50%" stop-color="#CBD5E1" />
        <stop offset="100%" stop-color="#64748B" />
      </linearGradient>

      <pattern id="trophyGrid" width="20" height="20" patternUnits="userSpaceOnUse">
        <circle cx="2" cy="2" r="0.75" fill="rgba(255, 255, 255, 0.04)" />
      </pattern>
    </defs>

    <!-- Main Container Card -->
    <rect x="15" y="15" width="490" height="310" rx="16" fill="url(#trophyGlass)" stroke="rgba(245, 158, 11, 0.3)" stroke-width="1.6" />
    <rect x="15" y="15" width="490" height="310" rx="16" fill="url(#trophyGrid)" />

    <!-- Top Window Bar -->
    <path d="M 15 52 L 505 52" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1.2" />
    <circle cx="36" cy="33" r="4.5" fill="#EF4444" />
    <circle cx="52" cy="33" r="4.5" fill="#F59E0B" />
    <circle cx="68" cy="33" r="4.5" fill="#10B981" />

    <text x="92" y="37" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="700" fill="#E2E8F0">
      laurels://vnit.syntax/hall_of_fame.registry
    </text>

    <!-- Championship Tag (Top Right) -->
    <g transform="translate(385, 22)">
      <rect x="0" y="0" width="110" height="22" rx="4" fill="rgba(245, 158, 11, 0.18)" stroke="#F59E0B" stroke-width="1" />
      <text x="55" y="15" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#FBBF24" text-anchor="middle">VERIFIED HONORS</text>
    </g>

    <!-- ========================================== -->
    <!-- CENTER: GRAND PODIUM & GOLDEN TROPHY       -->
    <!-- ========================================== -->
    <!-- Starburst Sparkles -->
    <path d="M 210 75 Q 210 85 220 85 Q 210 85 210 95 Q 210 85 200 85 Q 210 85 210 75 Z" fill="#FDE68A" />
    <path d="M 310 70 Q 310 80 320 80 Q 310 80 310 90 Q 310 80 300 80 Q 310 80 310 70 Z" fill="#38BDF8" />
    <circle cx="215" cy="140" r="2.5" fill="#C084FC" />
    <circle cx="305" cy="145" r="2.5" fill="#F59E0B" />

    <!-- Laurel Wreath Around Center Trophy -->
    <!-- Left Laurel Branch -->
    <path d="M 210 95 C 190 120, 195 160, 225 185" stroke="#10B981" stroke-width="2" stroke-linecap="round" fill="none" />
    <ellipse cx="198" cy="110" rx="6" ry="3.5" transform="rotate(-30 198 110)" fill="#10B981" />
    <ellipse cx="192" cy="130" rx="6" ry="3.5" transform="rotate(-15 192 130)" fill="#10B981" />
    <ellipse cx="196" cy="150" rx="6" ry="3.5" transform="rotate(10 196 150)" fill="#10B981" />
    <ellipse cx="208" cy="170" rx="6" ry="3.5" transform="rotate(35 208 170)" fill="#10B981" />

    <!-- Right Laurel Branch -->
    <path d="M 310 95 C 330 120, 325 160, 295 185" stroke="#10B981" stroke-width="2" stroke-linecap="round" fill="none" />
    <ellipse cx="322" cy="110" rx="6" ry="3.5" transform="rotate(30 322 110)" fill="#10B981" />
    <ellipse cx="328" cy="130" rx="6" ry="3.5" transform="rotate(15 328 130)" fill="#10B981" />
    <ellipse cx="324" cy="150" rx="6" ry="3.5" transform="rotate(-10 324 150)" fill="#10B981" />
    <ellipse cx="312" cy="170" rx="6" ry="3.5" transform="rotate(-35 312 170)" fill="#10B981" />

    <!-- Main Trophy Cup -->
    <g transform="translate(260, 75)">
      <!-- Left & Right Handles -->
      <path d="M -26 20 C -42 20, -42 50, -20 54" stroke="url(#goldChampionship)" stroke-width="2.5" stroke-linecap="round" fill="none" />
      <path d="M 26 20 C 42 20, 42 50, 20 54" stroke="url(#goldChampionship)" stroke-width="2.5" stroke-linecap="round" fill="none" />

      <!-- Cup Body -->
      <path d="M -26 10 H 26 L 22 62 C 18 80, -18 80, -22 62 Z" fill="url(#goldChampionship)" stroke="#FFFFFF" stroke-width="1.6" stroke-linejoin="round" />
      
      <!-- Cup Inner specular highlight -->
      <path d="M -16 16 H 16 L 13 46 C 10 58, -10 58, -13 46 Z" fill="rgba(255, 255, 255, 0.18)" />

      <!-- SyntaX S-Insignia on Cup -->
      <path d="M -8 32 C -8 26, 8 26, 8 34 C 8 42, -8 42, -8 50 C -8 58, 8 58, 8 52" stroke="#0B0F19" stroke-width="2.2" stroke-linecap="round" fill="none" />

      <!-- Stem & Base -->
      <rect x="-6" y="78" width="12" height="18" fill="url(#goldChampionship)" stroke="#FFFFFF" stroke-width="1" />
      <rect x="-24" y="96" width="48" height="24" rx="3" fill="#0B0F19" stroke="#F59E0B" stroke-width="1.6" />
      <text x="0" y="112" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="800" fill="#FBBF24" text-anchor="middle">VNIT #1</text>
    </g>

    <!-- Center Podium Step (1st) -->
    <rect x="215" y="195" width="90" height="60" rx="4" fill="rgba(245, 158, 11, 0.15)" stroke="#F59E0B" stroke-width="1.6" />
    <text x="260" y="232" font-family="'JetBrains Mono', monospace" font-size="22" font-weight="800" fill="#FBBF24" text-anchor="middle">1</text>

    <!-- Left Podium Step (2nd - ICPC Regionals) -->
    <rect x="135" y="215" width="80" height="40" rx="4" fill="rgba(139, 92, 246, 0.12)" stroke="#8B5CF6" stroke-width="1.4" />
    <text x="175" y="242" font-family="'JetBrains Mono', monospace" font-size="18" font-weight="800" fill="#C084FC" text-anchor="middle">2</text>

    <!-- Right Podium Step (3rd - GSoC / SIH) -->
    <rect x="305" y="225" width="80" height="30" rx="4" fill="rgba(46, 211, 254, 0.12)" stroke="#2ED3FE" stroke-width="1.4" />
    <text x="345" y="247" font-family="'JetBrains Mono', monospace" font-size="16" font-weight="800" fill="#2ED3FE" text-anchor="middle">3</text>

    <!-- ========================================== -->
    <!-- LEFT BADGE: ACM-ICPC REGIONALS MEDAL       -->
    <!-- ========================================== -->
    <g transform="translate(35, 75)">
      <rect x="0" y="0" width="140" height="110" rx="10" fill="rgba(139, 92, 246, 0.08)" stroke="rgba(139, 92, 246, 0.35)" stroke-width="1.2" />
      
      <!-- Medal Ribbons -->
      <path d="M 50 14 L 60 40 L 70 14 Z" fill="#EF4444" />
      <path d="M 70 14 L 80 40 L 90 14 Z" fill="#3B82F6" />

      <!-- Medal Disc -->
      <circle cx="70" cy="52" r="16" fill="url(#silverMedal)" stroke="#FFFFFF" stroke-width="1.5" />
      <text x="70" y="56" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="800" fill="#0B0F19" text-anchor="middle">ICPC</text>

      <text x="70" y="82" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#C084FC" text-anchor="middle">REGIONAL FINALISTS</text>
      <text x="70" y="96" font-family="'JetBrains Mono', monospace" font-size="7" fill="#94A3B8" text-anchor="middle">Amritapuri & Kanpur</text>
    </g>

    <!-- ========================================== -->
    <!-- RIGHT BADGE: SMART INDIA HACKATHON & GSOC  -->
    <!-- ========================================== -->
    <g transform="translate(345, 75)">
      <rect x="0" y="0" width="140" height="110" rx="10" fill="rgba(46, 211, 254, 0.08)" stroke="rgba(46, 211, 254, 0.35)" stroke-width="1.2" />
      
      <!-- SIH Shield Badge -->
      <path d="M 70 18 L 86 26 V 46 C 86 58, 70 66, 70 66 C 70 66, 54 58, 54 46 V 26 Z" fill="rgba(46, 211, 254, 0.2)" stroke="#2ED3FE" stroke-width="1.6" />
      <text x="70" y="44" font-family="'JetBrains Mono', monospace" font-size="8.5" font-weight="800" fill="#2ED3FE" text-anchor="middle">SIH</text>

      <text x="70" y="82" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#38BDF8" text-anchor="middle">NATIONAL TOP 5</text>
      <text x="70" y="96" font-family="'JetBrains Mono', monospace" font-size="7" fill="#94A3B8" text-anchor="middle">Grand Finalists · GSoC</text>
    </g>

    <!-- Bottom Ticker / Banner inside Card -->
    <g transform="translate(35, 268)">
      <rect x="0" y="0" width="450" height="42" rx="8" fill="#07090E" stroke="rgba(255, 255, 255, 0.1)" stroke-width="1" />
      <circle cx="20" cy="21" r="4" fill="#10B981" />
      <text x="32" y="19" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#E2E8F0">
        RECORD INTEGRITY: 100% VERIFIED ON-SITE MERIT
      </text>
      <text x="32" y="32" font-family="'JetBrains Mono', monospace" font-size="7" fill="#64748B">
        Zero inflated or unverified records. Every milestone certified by competition juries.
      </text>
      
      <!-- Laurel count -->
      <text x="435" y="26" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="800" fill="#F59E0B" text-anchor="end">
        12+ Podiums
      </text>
    </g>
  </svg>
</div>
