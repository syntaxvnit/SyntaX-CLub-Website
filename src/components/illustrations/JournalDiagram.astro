---
interface Props {
  category?: string;
  slug?: string;
  className?: string;
  size?: number;
}

const { category = "Systems", slug = "", className = "", size = 520 } = Astro.props;

const isAlgorithms = category === "Algorithms" || slug.includes("segment");
const isAI = category === "AI & ML" || slug.includes("rag") || slug.includes("llm");
---

<div class={`journal-diagram-container relative select-none ${className}`}>
  <!-- Subtle ambient glow -->
  <div class="absolute -inset-2 bg-gradient-to-r from-[#2ED3FE]/15 via-[#8B5CF6]/15 to-transparent rounded-2xl blur-xl opacity-50 -z-10"></div>

  {isAlgorithms ? (
    <svg viewBox="0 0 520 280" width={size} fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto filter drop-shadow-xl" aria-label="Lazy Segment Tree Algorithmic Architecture">
      <defs>
        <linearGradient id="jdAlgGlass" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="rgba(15, 23, 42, 0.94)" />
          <stop offset="100%" stop-color="rgba(10, 14, 26, 0.98)" />
        </linearGradient>
      </defs>

      <rect x="10" y="10" width="500" height="260" rx="14" fill="url(#jdAlgGlass)" stroke="rgba(139, 92, 246, 0.3)" stroke-width="1.4" />
      <path d="M 10 42 L 510 42" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1" />
      <circle cx="28" cy="26" r="3.5" fill="#EF4444" />
      <circle cx="40" cy="26" r="3.5" fill="#F59E0B" />
      <circle cx="52" cy="26" r="3.5" fill="#10B981" />

      <text x="70" y="30" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#E2E8F0">
        FIG 1.2: LAZY_PROPAGATION_CASCADE · interval_update([2, 5], +7)
      </text>

      <!-- Segment Tree Hierarchy -->
      <!-- Edges -->
      <line x1="260" y1="80" x2="170" y2="120" stroke="#8B5CF6" stroke-width="1.8" />
      <line x1="260" y1="80" x2="350" y2="120" stroke="#2ED3FE" stroke-width="2" />
      
      <line x1="170" y1="135" x2="125" y2="180" stroke="rgba(255, 255, 255, 0.2)" stroke-width="1.2" stroke-dasharray="2 2" />
      <line x1="170" y1="135" x2="215" y2="180" stroke="#8B5CF6" stroke-width="1.6" />

      <line x1="350" y1="135" x2="305" y2="180" stroke="#2ED3FE" stroke-width="2" />
      <line x1="350" y1="135" x2="395" y2="180" stroke="rgba(255, 255, 255, 0.2)" stroke-width="1.2" stroke-dasharray="2 2" />

      <!-- Root Node -->
      <circle cx="260" cy="75" r="15" fill="#0B0F19" stroke="#8B5CF6" stroke-width="2" />
      <text x="260" y="78" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#FFFFFF" text-anchor="middle">[0..7]</text>

      <!-- Left Child -->
      <circle cx="170" cy="125" r="13" fill="#0B0F19" stroke="#8B5CF6" stroke-width="1.6" />
      <text x="170" y="128" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#C084FC" text-anchor="middle">[0..3]</text>

      <!-- Right Child (Lazy Tag Attached) -->
      <circle cx="350" cy="125" r="15" fill="rgba(46, 211, 254, 0.2)" stroke="#2ED3FE" stroke-width="2" />
      <text x="350" y="128" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#2ED3FE" text-anchor="middle">[4..7]</text>

      <!-- Lazy Tag Badge -->
      <g transform="translate(375, 105)">
        <rect x="0" y="0" width="55" height="18" rx="4" fill="#0B0F19" stroke="#F59E0B" stroke-width="1" />
        <text x="27" y="12" font-family="'JetBrains Mono', monospace" font-size="6.5" font-weight="700" fill="#FBBF24" text-anchor="middle">lazy: +7</text>
      </g>

      <!-- Level 2 Nodes -->
      <circle cx="125" cy="190" r="10" fill="#0B0F19" stroke="rgba(255, 255, 255, 0.2)" stroke-width="1" />
      <text x="125" y="193" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#64748B" text-anchor="middle">[0..1]</text>

      <circle cx="215" cy="190" r="12" fill="rgba(139, 92, 246, 0.2)" stroke="#8B5CF6" stroke-width="1.6" />
      <text x="215" y="193" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="700" fill="#C084FC" text-anchor="middle">[2..3]</text>

      <circle cx="305" cy="190" r="12" fill="rgba(46, 211, 254, 0.25)" stroke="#2ED3FE" stroke-width="1.8" />
      <text x="305" y="193" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="700" fill="#2ED3FE" text-anchor="middle">[4..5]★</text>

      <circle cx="395" cy="190" r="10" fill="#0B0F19" stroke="rgba(255, 255, 255, 0.2)" stroke-width="1" />
      <text x="395" y="193" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#64748B" text-anchor="middle">[6..7]</text>

      <!-- Mathematical annotation callout -->
      <g transform="translate(30, 225)">
        <rect x="0" y="0" width="460" height="34" rx="6" fill="#07090E" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1" />
        <text x="14" y="16" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#38BDF8">
          void push(int v) &#123; if (lazy[v]) &#123; apply(2*v, lazy[v]); apply(2*v+1, lazy[v]); lazy[v] = 0; &#125; &#125;
        </text>
        <text x="14" y="27" font-family="'JetBrains Mono', monospace" font-size="7" fill="#10B981">
          Amortized Complexity: O(log N) per range update · Space: 4N nodes
        </text>
      </g>
    </svg>
  ) : isAI ? (
    <svg viewBox="0 0 520 280" width={size} fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto filter drop-shadow-xl" aria-label="RAG Vector Pipeline Architecture">
      <defs>
        <linearGradient id="jdAIGlass" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="rgba(15, 23, 42, 0.94)" />
          <stop offset="100%" stop-color="rgba(10, 14, 26, 0.98)" />
        </linearGradient>
      </defs>

      <rect x="10" y="10" width="500" height="260" rx="14" fill="url(#jdAIGlass)" stroke="rgba(46, 211, 254, 0.3)" stroke-width="1.4" />
      <path d="M 10 42 L 510 42" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1" />
      <circle cx="28" cy="26" r="3.5" fill="#EF4444" />
      <circle cx="40" cy="26" r="3.5" fill="#F59E0B" />
      <circle cx="52" cy="26" r="3.5" fill="#10B981" />

      <text x="70" y="30" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#E2E8F0">
        FIG 2.1: STRUCTURED_RAG_PIPELINE · embed → HNSW_index → SLM_eval
      </text>

      <!-- 4 Stages of Pipeline -->
      <!-- Stage 1: Document Chunking -->
      <g transform="translate(25, 65)">
        <rect x="0" y="0" width="95" height="135" rx="8" fill="rgba(255, 255, 255, 0.02)" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1" />
        <text x="10" y="20" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#94A3B8">01 · CHUNKING</text>
        <rect x="10" y="34" width="75" height="16" rx="3" fill="rgba(56, 189, 248, 0.1)" stroke="rgba(56, 189, 248, 0.25)" />
        <text x="14" y="45" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#38BDF8">chunk_size: 512</text>
        <rect x="10" y="56" width="75" height="16" rx="3" fill="rgba(56, 189, 248, 0.1)" stroke="rgba(56, 189, 248, 0.25)" />
        <text x="14" y="67" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#38BDF8">overlap: 64 tok</text>
        <rect x="10" y="78" width="75" height="42" rx="3" fill="#0B0F19" />
        <text x="14" y="93" font-family="'JetBrains Mono', monospace" font-size="6" fill="#64748B">RecursiveText</text>
        <text x="14" y="105" font-family="'JetBrains Mono', monospace" font-size="6" fill="#64748B">Splitter()</text>
      </g>

      <!-- Arrow 1 -> 2 -->
      <path d="M 125 130 L 145 130" stroke="#38BDF8" stroke-width="1.6" stroke-dasharray="2 2" />

      <!-- Stage 2: Dense Embedding -->
      <g transform="translate(148, 65)">
        <rect x="0" y="0" width="95" height="135" rx="8" fill="rgba(46, 211, 254, 0.08)" stroke="#2ED3FE" stroke-width="1.2" />
        <text x="10" y="20" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#2ED3FE">02 · EMBEDDING</text>
        <!-- Embedding Vector Matrix -->
        <g transform="translate(10, 32)">
          <rect x="0" y="0" width="75" height="70" rx="4" fill="#0B0F19" stroke="rgba(46, 211, 254, 0.3)" />
          <text x="8" y="16" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#38BDF8">[+0.142,</text>
          <text x="8" y="28" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#38BDF8">-0.891,</text>
          <text x="8" y="40" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#38BDF8">+0.320,</text>
          <text x="8" y="52" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#38BDF8">... 768d]</text>
        </g>
        <text x="10" y="122" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#94A3B8">bge-small-en-v1.5</text>
      </g>

      <!-- Arrow 2 -> 3 -->
      <path d="M 248 130 L 268 130" stroke="#8B5CF6" stroke-width="1.6" stroke-dasharray="2 2" />

      <!-- Stage 3: HNSW Vector Graph -->
      <g transform="translate(272, 65)">
        <rect x="0" y="0" width="105" height="135" rx="8" fill="rgba(139, 92, 246, 0.08)" stroke="#8B5CF6" stroke-width="1.2" />
        <text x="10" y="20" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#C084FC">03 · HNSW INDEX</text>
        
        <!-- Vector Graph Nodes -->
        <circle cx="28" cy="50" r="6" fill="#8B5CF6" />
        <circle cx="75" cy="45" r="5" fill="#2ED3FE" />
        <circle cx="45" cy="85" r="7" fill="#10B981" />
        <circle cx="80" cy="80" r="5" fill="#8B5CF6" />
        
        <line x1="28" y1="50" x2="75" y2="45" stroke="rgba(255,255,255,0.2)" stroke-width="1" />
        <line x1="28" y1="50" x2="45" y2="85" stroke="#10B981" stroke-width="1.6" />
        <line x1="75" y1="45" x2="80" y2="80" stroke="rgba(255,255,255,0.2)" stroke-width="1" />
        <line x1="45" y1="85" x2="80" y2="80" stroke="#8B5CF6" stroke-width="1.4" />

        <text x="10" y="118" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#34D399">Top-5 Similarity</text>
      </g>

      <!-- Arrow 3 -> 4 -->
      <path d="M 382 130 L 402 130" stroke="#10B981" stroke-width="1.6" stroke-dasharray="2 2" />

      <!-- Stage 4: On-Device SLM -->
      <g transform="translate(405, 65)">
        <rect x="0" y="0" width="90" height="135" rx="8" fill="rgba(16, 185, 129, 0.08)" stroke="#10B981" stroke-width="1.2" />
        <text x="10" y="20" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#34D399">04 · LOCAL SLM</text>
        <circle cx="45" cy="60" r="18" fill="#0B0F19" stroke="#10B981" stroke-width="1.8" />
        <circle cx="45" cy="60" r="7" fill="#34D399" class="animate-pulse" />
        <text x="45" y="98" font-family="'JetBrains Mono', monospace" font-size="6.5" font-weight="700" fill="#FFFFFF" text-anchor="middle">Llama 3.2 3B</text>
        <text x="45" y="112" font-family="'JetBrains Mono', monospace" font-size="6" fill="#94A3B8" text-anchor="middle">4-bit AWQ (3.1GB)</text>
      </g>

      <!-- Metrics Tape -->
      <g transform="translate(25, 215)">
        <rect x="0" y="0" width="470" height="38" rx="6" fill="#07090E" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1" />
        <text x="14" y="18" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#2ED3FE">
          LATENCY BENCHMARK: Retrieval: 14ms · Rerank: 8ms · Generation: 42 tok/s
        </text>
        <text x="14" y="30" font-family="'JetBrains Mono', monospace" font-size="7" fill="#64748B">
          Zero token leaks to third-party endpoints. Strictly private VNIT campus archive.
        </text>
      </g>
    </svg>
  ) : (
    <svg viewBox="0 0 520 280" width={size} fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto filter drop-shadow-xl" aria-label="Static-First Island Architecture">
      <defs>
        <linearGradient id="jdSysGlass" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="rgba(15, 23, 42, 0.94)" />
          <stop offset="100%" stop-color="rgba(10, 14, 26, 0.98)" />
        </linearGradient>
      </defs>

      <rect x="10" y="10" width="500" height="260" rx="14" fill="url(#jdSysGlass)" stroke="rgba(46, 211, 254, 0.3)" stroke-width="1.4" />
      <path d="M 10 42 L 510 42" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1" />
      <circle cx="28" cy="26" r="3.5" fill="#EF4444" />
      <circle cx="40" cy="26" r="3.5" fill="#F59E0B" />
      <circle cx="52" cy="26" r="3.5" fill="#10B981" />

      <text x="70" y="30" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#E2E8F0">
        FIG 3.1: ISLAND_HYDRATION_TOPOLOGY · client:idle vs pure SSG HTML
      </text>

      <!-- Architecture Flow -->
      <!-- Left: Static HTML Document Shell (Zero JS) -->
      <g transform="translate(30, 65)">
        <rect x="0" y="0" width="180" height="135" rx="8" fill="rgba(255, 255, 255, 0.02)" stroke="rgba(255, 255, 255, 0.1)" stroke-width="1" />
        <rect x="0" y="0" width="180" height="20" rx="8" fill="rgba(255, 255, 255, 0.04)" />
        <text x="10" y="14" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="700" fill="#94A3B8">PURE STATIC HTML (0 KB JS)</text>
        
        <rect x="12" y="32" width="156" height="18" rx="3" fill="rgba(255, 255, 255, 0.03)" />
        <text x="18" y="44" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#64748B">&lt;header&gt; Static Nav &lt;/header&gt;</text>

        <!-- Dynamic Hydrated Island (Glowing Purple) -->
        <rect x="12" y="58" width="156" height="42" rx="4" fill="rgba(139, 92, 246, 0.15)" stroke="#8B5CF6" stroke-width="1.2" />
        <circle cx="24" cy="74" r="3.5" fill="#34D399" class="animate-pulse" />
        <text x="34" y="77" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#C084FC">&lt;SearchModal client:idle /&gt;</text>
        <text x="34" y="90" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#38BDF8">JS deferred until user idle</text>

        <rect x="12" y="108" width="156" height="18" rx="3" fill="rgba(255, 255, 255, 0.03)" />
        <text x="18" y="120" font-family="'JetBrains Mono', monospace" font-size="6.5" fill="#64748B">&lt;footer&gt; Zero Runtime &lt;/footer&gt;</text>
      </g>

      <!-- Connecting Conduits to Performance Radar -->
      <path d="M 215 130 C 255 130, 255 110, 290 110" stroke="#2ED3FE" stroke-width="2" fill="none" />
      <circle cx="255" cy="120" r="3.5" fill="#2ED3FE" />

      <!-- Right: Performance Lighthouse Radar -->
      <g transform="translate(290, 65)">
        <rect x="0" y="0" width="200" height="135" rx="8" fill="rgba(16, 185, 129, 0.08)" stroke="#10B981" stroke-width="1.4" />
        <text x="14" y="22" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="700" fill="#34D399">LIGHTHOUSE PERFORMANCE</text>

        <g transform="translate(14, 38)">
          <!-- Score Pill -->
          <circle cx="30" cy="30" r="24" fill="#0B0F19" stroke="#10B981" stroke-width="2.5" />
          <text x="30" y="34" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="800" fill="#34D399" text-anchor="middle">100</text>

          <text x="68" y="18" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#94A3B8">FCP: <strong class="text-white">0.3s</strong></text>
          <text x="68" y="32" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#94A3B8">LCP: <strong class="text-white">0.6s</strong></text>
          <text x="68" y="46" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#94A3B8">CLS: <strong class="text-white">0.000</strong></text>
          <text x="68" y="60" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#94A3B8">FID: <strong class="text-white">8ms</strong></text>
        </g>
      </g>

      <!-- Bottom Principle Strip -->
      <g transform="translate(30, 215)">
        <rect x="0" y="0" width="460" height="38" rx="6" fill="#07090E" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1" />
        <text x="14" y="18" font-family="'JetBrains Mono', monospace" font-size="7.5" font-weight="700" fill="#2ED3FE">
          CORE AXIOM: Shipping zero JS by default eliminates hydration mismatches and memory leaks.
        </text>
        <text x="14" y="30" font-family="'JetBrains Mono', monospace" font-size="7" fill="#64748B">
          Measured over 34 static routes compiled via Vite + Astro static asset pipelines.
        </text>
      </g>
    </svg>
  )}
</div>
