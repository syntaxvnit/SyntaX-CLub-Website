---
interface Props {
  forceShow?: boolean;
}

const { forceShow = false } = Astro.props;
---

<div
  id="syntax-animation-loader"
  class="syntax-animation-overlay"
  aria-hidden="true"
  data-force-show={forceShow ? "true" : "false"}
>
  <!-- Ambient Luminous Glow behind the animation to blend into black background -->
  <div class="animation-ambient-glow" aria-hidden="true"></div>

  <!-- Fullscreen Animated Canvas Container (Zero controls, zero chrome) -->
  <div class="animation-viewport">
    <video
      id="syntax-loader-video"
      playsinline
      webkit-playsinline="true"
      muted
      autoplay
      preload="auto"
      disablepictureinpicture
      disableremoteplayback
      controlslist="nodownload nofullscreen noremoteplayback noplaybackrate"
      class="animation-media"
      tabindex="-1"
      aria-hidden="true"
    >
      <source src="/video/syntax-logo-opening.webm" type="video/webm" />
      <source src="/video/syntax-logo-opening.mp4" type="video/mp4" />
    </video>
  </div>
</div>

<style>
  .syntax-animation-overlay {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    z-index: 999999;
    background-color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    cursor: default;
    user-select: none;
    -webkit-user-select: none;
    transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.85s ease;
    opacity: 1;
    visibility: visible;
  }

  .syntax-animation-overlay.is-hidden {
    opacity: 0;
    visibility: hidden;
    transform: scale(1.05);
    filter: blur(12px);
    pointer-events: none;
  }

  .animation-ambient-glow {
    position: absolute;
    width: 75vw;
    height: 75vh;
    max-width: 950px;
    max-height: 950px;
    border-radius: 50%;
    background: radial-gradient(
      circle at center,
      rgba(46, 211, 254, 0.2) 0%,
      rgba(139, 92, 246, 0.14) 40%,
      transparent 70%
    );
    filter: blur(70px);
    pointer-events: none;
    z-index: 1;
    animation: ambientPulse 5s ease-in-out infinite;
  }

  @keyframes ambientPulse {
    0%, 100% {
      opacity: 0.6;
      transform: scale(0.96);
    }
    50% {
      opacity: 1;
      transform: scale(1.04);
    }
  }

  .animation-viewport {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    background: transparent;
  }

  .animation-media {
    width: 100%;
    height: 100%;
    max-width: 100vw;
    max-height: 100vh;
    object-fit: contain;
    display: block;
    background-color: #000000;
    pointer-events: none;
    border: none;
    outline: none;
    box-shadow: none;
  }

  .animation-media::-webkit-media-controls,
  .animation-media::-webkit-media-controls-enclosure,
  .animation-media::-webkit-media-controls-panel,
  .animation-media::-webkit-media-controls-play-button,
  .animation-media::-webkit-media-controls-start-playback-button {
    display: none !important;
    -webkit-appearance: none;
    opacity: 0 !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .syntax-animation-overlay {
      display: none !important;
    }
  }

  :global(astro-dev-toolbar) {
    display: none !important;
  }
</style>

<script>
  function initAnimationLoader() {
    const overlay = document.getElementById('syntax-animation-loader');
    const video = document.getElementById('syntax-loader-video') as HTMLVideoElement | null;
    if (!overlay) return;

    const urlParams = new URLSearchParams(window.location.search);
    const forceShow =
      overlay.getAttribute('data-force-show') === 'true' ||
      urlParams.get('intro') === '1' ||
      urlParams.get('loader') === '1';

    // Check if this navigation is a browser reload
    const navEntries = performance.getEntriesByType('navigation');
    const isReload = navEntries.length > 0 && (navEntries[0] as PerformanceNavigationTiming).type === 'reload';

    const hasSeen = sessionStorage.getItem('syntax_logo_animation_seen');
    const skipParam = urlParams.get('skip') === '1' || urlParams.get('intro') === '0';

    // Only skip if user has already seen it in this browser session (or skip requested) AND did not reload / forceShow
    if ((hasSeen || skipParam) && !forceShow && !isReload) {
      overlay.remove();
      return;
    }

    // Lock page scrolling while animation plays
    document.body.style.overflow = 'hidden';

    let dismissed = false;
    function dismissAnimation() {
      if (dismissed) return;
      dismissed = true;
      sessionStorage.setItem('syntax_logo_animation_seen', 'true');
      document.body.style.overflow = '';
      overlay?.classList.add('is-hidden');
      if (video) {
        setTimeout(() => {
          try {
            video.pause();
          } catch (_) {}
        }, 300);
      }
      setTimeout(() => {
        if (overlay && overlay.parentNode) {
          overlay.remove();
        }
      }, 900);
    }

    // Seamless instant bypass on click or escape without showing any controls
    overlay.addEventListener('click', dismissAnimation);
    overlay.addEventListener('contextmenu', (e) => e.preventDefault());
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' || e.key === ' ' || e.key === 'Enter') {
        dismissAnimation();
      }
    });

    if (video) {
      video.muted = true;
      video.defaultMuted = true;
      video.removeAttribute('controls');
      video.addEventListener('contextmenu', (e) => e.preventDefault());
      video.addEventListener('ended', dismissAnimation);
      video.addEventListener('timeupdate', () => {
        // Trigger smooth fade slightly before the hard stop for cinematic seamlessness
        if (video.duration && video.currentTime >= video.duration - 0.25) {
          dismissAnimation();
        }
      });

      const seekParam = parseFloat(urlParams.get('t') || urlParams.get('time') || '0');
      if (seekParam > 0) {
        video.currentTime = seekParam;
      }

      // Attempt autoplay
      const playPromise = video.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {
          // If browser policy blocks autoplay even when muted, dismiss gracefully
          dismissAnimation();
        });
      }
    }

    // Failsafe timeout: duration is ~5.38s so 5.8s timeout ensures visitor never gets stuck
    setTimeout(dismissAnimation, 5800);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAnimationLoader);
  } else {
    initAnimationLoader();
  }
</script>
