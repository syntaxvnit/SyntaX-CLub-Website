
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Coming Soon | SyntaX"
  description="Something exciting is coming soon from SyntaX VNIT."
>
  <main class="coming-soon">
    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>

    <div class="grid-overlay"></div>

    <section class="content">
      <div class="brand">
        <span class="brand-dot"></span>
        SYNTAX <span class="brand-light">/ VNIT NAGPUR</span>
      </div>

      <div class="status">
        <span class="status-dot"></span>
        SOMETHING IS IN DEVELOPMENT
      </div>

      <div class="main-heading">
        <p class="eyebrow">THE NEXT CHAPTER BEGINS</p>

        <h1>
          Something<br />
          <span class="gradient-text">Exciting</span><br />
          Is Coming.
        </h1>

        <p class="description">
          We're working behind the scenes to bring you something
          extraordinary. Stay tuned. The wait will be worth it.
        </p>

        <div class="countdown-line">
          <span></span>
          <span>BUILT WITH CREATIVITY. POWERED BY INNOVATION.</span>
          <span></span>
        </div>

        <a href="/" class="home-button">
          <span>Back to Home</span>
          <span class="arrow">↗</span>
        </a>
      </div>

      <div class="bottom-info">
        <span>© 2026 SYNTAX VNIT</span>
        <span>INNOVATE. BUILD. REPEAT.</span>
      </div>
    </section>

    <div class="orb orb-one"></div>
    <div class="orb orb-two"></div>
  </main>
</BaseLayout>

<style>
  :global(body) {
    margin: 0;
    background: #070910;
  }

  .coming-soon {
    min-height: 100vh;
    min-height: 100svh;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #070910;
    color: #f4f5fa;
    font-family: var(--font-mono, monospace);
    isolation: isolate;
    padding: 40px 24px;
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
    background-size: 55px 55px;
    mask-image: linear-gradient(to bottom, transparent, black 20%, black 80%, transparent);
  }

  .ambient {
    position: absolute;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    filter: blur(130px);
    opacity: .2;
    z-index: -1;
    pointer-events: none;
  }

  .ambient-one {
    background: #00d9ff;
    top: -250px;
    left: -150px;
  }

  .ambient-two {
    background: #873bff;
    bottom: -270px;
    right: -130px;
  }

  .content {
    width: min(100%, 900px);
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .brand {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 4px;
    margin-bottom: 75px;
  }

  .brand-dot,
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #00e5ff;
    box-shadow: 0 0 14px #00e5ff;
  }

  .brand-light {
    color: #777e91;
    font-size: 10px;
    letter-spacing: 2px;
    font-weight: 400;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 17px;
    border: 1px solid rgba(0, 229, 255, .22);
    background: rgba(0, 229, 255, .055);
    border-radius: 50px;
    color: #83eafa;
    font-size: 10px;
    letter-spacing: 2px;
    margin-bottom: 35px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    animation: pulse 1.8s infinite;
  }

  .eyebrow {
    color: #8c91a5;
    font-size: 11px;
    letter-spacing: 5px;
    margin-bottom: 25px;
  }

  h1 {
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(55px, 9vw, 105px);
    font-weight: 500;
    letter-spacing: -5px;
    line-height: .98;
    margin: 0;
  }

  .gradient-text {
    background: linear-gradient(100deg, #00e5ff, #8295ff 50%, #c17bff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .description {
    max-width: 480px;
    margin: 30px auto;
    color: #9299aa;
    font-family: Arial, sans-serif;
    font-size: 15px;
    line-height: 1.9;
  }

  .countdown-line {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    color: #626b80;
    font-size: 9px;
    letter-spacing: 2px;
    margin: 35px 0;
  }

  .countdown-line span:first-child,
  .countdown-line span:last-child {
    width: 35px;
    height: 1px;
    background: linear-gradient(90deg, transparent, #00dfff);
  }

  .countdown-line span:last-child {
    background: linear-gradient(90deg, #b66bff, transparent);
  }

  .home-button {
    display: inline-flex;
    align-items: center;
    gap: 30px;
    padding: 15px 23px;
    border: 1px solid rgba(0, 225, 255, .4);
    border-radius: 5px;
    color: #e9faff;
    background: rgba(0, 225, 255, .07);
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 1px;
    transition: .3s ease;
  }

  .home-button:hover {
    background: rgba(0, 225, 255, .16);
    border-color: #00e5ff;
    box-shadow: 0 0 30px rgba(0, 225, 255, .15);
    transform: translateY(-3px);
  }

  .arrow {
    color: #00e5ff;
    font-size: 19px;
  }

  .bottom-info {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    margin-top: 95px;
    color: #555c70;
    font-size: 9px;
    letter-spacing: 2px;
  }

  .orb {
    position: absolute;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    border: 1px solid rgba(0, 225, 255, .1);
    z-index: -1;
    pointer-events: none;
  }

  .orb-one {
    top: 15%;
    right: 8%;
    box-shadow: 0 0 70px rgba(0, 225, 255, .06),
      inset 0 0 60px rgba(0, 225, 255, .04);
  }

  .orb-two {
    width: 130px;
    height: 130px;
    bottom: 12%;
    left: 8%;
    border-color: rgba(170, 100, 255, .17);
    box-shadow: 0 0 70px rgba(170, 100, 255, .1);
  }

  @keyframes pulse {
    50% { opacity: .35; }
  }

  @media (max-width: 600px) {
    .coming-soon { padding: 35px 20px; }
    .brand { margin-bottom: 65px; }
    h1 { letter-spacing: -3px; }
    .description { font-size: 14px; }
    .bottom-info {
      flex-direction: column;
      align-items: center;
      margin-top: 75px;
    }
    .orb-one { right: -120px; }
    .orb-two { left: -70px; }
  }
</style>
</BaseLayout>
