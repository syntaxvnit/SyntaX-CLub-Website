
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { events, type ClubEvent } from '../../data/events';
import WebDevDoodle from '../../components/illustrations/WebDevDoodle.astro';
import CPDoodle from '../../components/illustrations/CPDoodle.astro';
import AIDoodle from '../../components/illustrations/AIDoodle.astro';
import SynHackDoodle from '../../components/illustrations/SynHackDoodle.astro';
import ScrollReveal from '../../components/motion/ScrollReveal.astro';

export function getStaticPaths() {
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

interface Props {
  event: ClubEvent;
}

const { event } = Astro.props;

// Temporary gallery images.
// Replace these URLs with actual SyntaX event photographs later.
const gallery = [
  {
    src: `/images/events/${event.slug}/photo-1.jpg`,
    alt: `${event.title} - Event photograph 1`,
    caption: 'Event Moments',
  },
  {
    src: `/images/events/${event.slug}/photo-2.jpg`,
    alt: `${event.title} - Event photograph 2`,
    caption: 'Team Collaboration',
  },
  {
    src: `/images/events/${event.slug}/photo-3.jpg`,
    alt: `${event.title} - Event photograph 3`,
    caption: 'Learning Together',
  },
  {
    src: `/images/events/${event.slug}/photo-4.jpg`,
    alt: `${event.title} - Event photograph 4`,
    caption: 'Behind The Scenes',
  },
];
---

<BaseLayout
  title={`${event.title} | SyntaX VNIT Events`}
  description={event.summary}
>
  <article class="section pt-8 pb-20">
    <div class="container max-w-6xl space-y-10">

      <!-- BREADCRUMB -->
      <ScrollReveal animation="fade-up">
        <nav class="font-mono text-xs text-slate-400 flex items-center gap-2 flex-wrap">
          <a href="/" class="hover:text-white">Home</a>
          <span>/</span>
          <a href="/events" class="hover:text-white">Events</a>
          <span>/</span>
          <span class="text-cyan-400 truncate">{event.title}</span>
        </nav>
      </ScrollReveal>

      <!-- EVENT INFORMATION -->
      <ScrollReveal animation="fade-up" delay={100}>
        <div class="card p-6 md:p-10 lg:p-12 bg-gradient-to-br from-[#0F172A] to-[#0A0E1A] border border-cyan-500/30">

          <div class="flex flex-wrap items-center justify-between gap-3 mb-6">

            <div class="flex flex-wrap gap-2">
              <span class="badge badge-brand text-xs">
                {event.category}
              </span>

              <span class="badge badge-emerald text-xs">
                {event.status.toUpperCase()}
              </span>
            </div>

            <span class="font-mono text-xs text-slate-400">
              {event.date}
            </span>

          </div>

          <h1 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight">
            {event.title}
          </h1>

          <p class="text-base md:text-lg text-slate-300 leading-relaxed mt-5 max-w-3xl">
            {event.summary}
          </p>

          <div class="mt-6 flex flex-wrap gap-5 text-sm font-mono text-slate-400">

            <span>
              <span class="text-cyan-400">⌖</span>
              {event.venue}
            </span>

            <span>
              <span class="text-cyan-400">◷</span>
              {event.year}
            </span>

          </div>

          <!-- EVENT ARTWORK -->
          <div class="mt-9 p-5 md:p-8 rounded-2xl bg-white/[0.02] border border-white/5 flex justify-center items-center">

            {event.doodleType === 'web' && <WebDevDoodle size={500} />}
            {event.doodleType === 'cp' && <CPDoodle size={500} />}
            {event.doodleType === 'ai' && <AIDoodle size={500} />}
            {event.doodleType === 'hackathon' && <SynHackDoodle size={500} />}
            {event.doodleType === 'general' && <WebDevDoodle size={500} />}

          </div>

          <!-- EVENT OVERVIEW -->
          <div class="mt-9 pt-7 border-t border-white/10">

            <span class="font-mono text-xs tracking-widest text-cyan-400">
              ABOUT THE EVENT
            </span>

            <h2 class="text-2xl font-bold text-white mt-3 mb-4">
              The Story Behind It.
            </h2>

            <p class="text-base md:text-lg text-slate-300 leading-relaxed">
              {event.description}
            </p>

          </div>

          <!-- INSTAGRAM LINK -->
          <div class="mt-8 flex flex-wrap items-center justify-between gap-4">

            <div>
              <p class="text-sm font-bold text-white">
                Want to explore more?
              </p>
              <p class="text-xs text-slate-400 mt-1">
                Follow SyntaX for event updates and memories.
              </p>
            </div>

            <a
              href={event.instagramUrl || 'https://www.instagram.com/syntax_vnit/'}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary text-xs font-mono py-3 px-6"
            >
              Instagram ↗
            </a>

          </div>

        </div>
      </ScrollReveal>

      <!-- HIGHLIGHTS + GALLERY -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">

        <!-- EVENT HIGHLIGHTS -->
        <ScrollReveal animation="fade-up" delay={100}>
          <section class="card p-6 md:p-8 h-full flex flex-col">

            <div class="flex items-center justify-between gap-3 mb-6">

              <div>
                <span class="font-mono text-[10px] tracking-widest text-cyan-400">
  {event.status === 'upcoming' || event.status === 'open'
    ? 'EVENT INFORMATION'
    : 'EVENT RECAP'}
</span>

<h2 class="text-2xl font-extrabold text-white mt-2">
  {event.status === 'upcoming' || event.status === 'open'
    ? 'Event Details'
    : 'Highlights'}
  <span class="text-cyan-400">.</span>
</h2>
              </div>

              <span class="text-2xl text-cyan-400">✦</span>

            </div>

            <div class="w-full h-px bg-white/10 mb-6"></div>

            {event.highlights && event.highlights.length > 0 ? (

              <ul class="space-y-5 flex-1">

                {event.highlights.map((highlight, index) => (
                  <li class="flex items-start gap-4">

                    <span class="shrink-0 w-8 h-8 rounded-lg bg-cyan-400/10 border border-cyan-400/20 flex items-center justify-center text-xs font-mono font-bold text-cyan-400">
                      {String(index + 1).padStart(2, '0')}
                    </span>

                    <p class="text-sm md:text-base text-slate-300 leading-relaxed pt-1">
                      {highlight}
                    </p>

                  </li>
                ))}

              </ul>

            ) : (

              <p class="text-sm text-slate-400">
                Event highlights will be updated soon.
              </p>

            )}

            {event.takeaways && event.takeaways.length > 0 && (
              <div class="mt-7 pt-6 border-t border-white/10">

                <h3 class="font-mono text-xs tracking-wider text-purple-400 mb-4">
                  KEY TAKEAWAYS
                </h3>

                <ul class="space-y-3">
                  {event.takeaways.map((item) => (
                    <li class="text-sm text-slate-300 flex gap-3">
                      <span class="text-purple-400">›</span>
                      {item}
                    </li>
                  ))}
                </ul>

              </div>
            )}

          </section>
        </ScrollReveal>

        <!-- EVENT GALLERY -->
        <ScrollReveal animation="fade-up" delay={180}>
          <section class="card p-6 md:p-8 h-full flex flex-col">

            <div class="flex items-center justify-between gap-3 mb-6">

              <div>
                <span class="font-mono text-[10px] tracking-widest text-purple-400">
                  {event.status === 'upcoming' || event.status === 'open'
  ? 'EVENT PREVIEW'
  : 'MOMENTS CAPTURED'}
                </span>

                <h2 class="text-2xl font-extrabold text-white mt-2">
                  Event Gallery<span class="text-purple-400">.</span>
                </h2>
              </div>

              <span class="text-2xl text-purple-400">▧</span>

            </div>

            <div class="w-full h-px bg-white/10 mb-6"></div>

            <div class="grid grid-cols-2 gap-3 flex-1">

              {gallery.map((photo, index) => (
                <div class="group relative overflow-hidden rounded-xl border border-white/10 aspect-[4/3] bg-[#0F172A]">

                  <img
                    src={photo.src}
                    alt={photo.alt}
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                  />

                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-90"></div>

                  <div class="absolute bottom-0 left-0 right-0 p-3">
                    <span class="text-[10px] md:text-xs font-mono text-white font-semibold">
                      {photo.caption}
                    </span>
                  </div>

                  <span class="absolute top-2 right-2 w-6 h-6 rounded-md bg-black/50 backdrop-blur-md flex items-center justify-center text-[10px] text-white font-mono">
                    0{index + 1}
                  </span>

                </div>
              ))}

            </div>

            <div class="mt-5 pt-4 border-t border-white/10 flex items-center justify-between">

              <span class="text-[10px] font-mono text-slate-500">
                SYNTAX EVENT ARCHIVE
              </span>

              <span class="text-xs text-purple-400 font-mono">
                04 PHOTOS
              </span>

            </div>

          </section>
        </ScrollReveal>

      </div>

      <!-- BACK TO EVENTS -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 border-t border-white/10">

        <div>
          <h3 class="text-lg font-bold text-white">
            Explore more SyntaX events.
          </h3>
          <p class="text-xs text-slate-400 mt-1">
            Discover more workshops, competitions and hackathons.
          </p>
        </div>

        <a
          href="/events"
          class="btn btn-secondary font-mono text-xs py-3 px-6"
        >
          ← Back to All Events
        </a>

      </div>

    </div>
  </article>
</BaseLayout>
