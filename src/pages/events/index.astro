
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { events, eventYears, getEventsByYear } from '../../data/events';
import EventPoster from '../../components/illustrations/EventPoster.astro';
import ScrollReveal from '../../components/motion/ScrollReveal.astro';
import Ticker from '../../components/motion/Ticker.astro';

const categories = [
  { label: 'All Events', count: events.length },
  { label: 'Hackathons', count: events.filter((e) => e.category === 'Hackathon').length },
  { label: 'Workshops', count: events.filter((e) => e.category === 'Workshop').length },
  { label: 'CP', count: events.filter((e) => e.category === 'CP Contest').length },
  { label: 'AI', count: events.filter((e) => e.category === 'AI Bootcamp').length },
];

function getCategoryBadge(category: string) {
  switch (category) {
    case 'Hackathon': return 'badge-amber';
    case 'Workshop': return 'badge-brand';
    case 'CP Contest': return 'badge-purple';
    case 'AI Bootcamp': return 'badge-cyan';
    default: return 'badge';
  }
}
---

<BaseLayout
  title="Events | SyntaX VNIT"
  description="Explore SyntaX VNIT events, workshops, hackathons, and competitive programming sessions across the years."
>
  <!-- HEADER -->
  <section class="section pt-8 pb-10">
    <div class="container">
      <div class="max-w-3xl space-y-4">

        <ScrollReveal animation="fade-up" delay={100}>
          <div class="inline-flex items-center gap-2 p-1.5 pr-4 rounded-full bg-white/[0.04] border border-white/10 backdrop-blur-md">
            <span class="badge badge-brand text-[10px]">
              EVENT ARCHIVE
            </span>
            <span class="font-mono text-xs text-slate-400">
              S Y N T A X · V N I T
            </span>
          </div>
        </ScrollReveal>

        <ScrollReveal animation="fade-up" delay={180}>
          <h1 class="text-4xl sm:text-6xl font-extrabold text-white leading-tight">
            Ideas into <span class="text-gradient">action.</span>
          </h1>
        </ScrollReveal>

        <ScrollReveal animation="fade-up" delay={260}>
          <p class="text-lg md:text-xl text-slate-300 leading-relaxed max-w-2xl">
            From first lines of code to all-night builds — explore the workshops,
            challenges, and experiences organised by SyntaX.
          </p>
        </ScrollReveal>

        <ScrollReveal animation="fade-up" delay={340}>
          <div class="pt-3 flex flex-wrap gap-2">
            {categories.map((category) => (
              <span class="px-3.5 py-1.5 rounded-full text-xs font-mono bg-white/[0.04] border border-white/10 text-white">
                {category.label}
                <span class="text-cyan-400 font-bold">
                  ({category.count})
                </span>
              </span>
            ))}
          </div>
        </ScrollReveal>

      </div>
    </div>
  </section>

  <!-- TICKER -->
  <Ticker
    items={[
      'Learn by Building',
      'SynHack',
      'Competitive Programming',
      'Web Development',
      'Artificial Intelligence',
      'SyntaX VNIT'
    ]}
    variant="default"
  />

  <!-- YEAR-WISE EVENTS -->
  <section class="section pt-12 pb-20">
    <div class="container space-y-16">

      {eventYears.map((year, yearIndex) => {
        const yearEvents = getEventsByYear(year);
        const isCurrent = year === 2026;

        return (
          <div id={`events-${year}`} class="scroll-mt-24">

            <!-- YEAR HEADING -->
            <ScrollReveal animation="fade-up">
              <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 border-b border-white/10 pb-5 mb-7">

                <div>
                  <span class="section-label">
                    {isCurrent
                      ? 'LATEST EDITION & WHAT’S NEXT'
                      : 'FROM THE ARCHIVE'}
                  </span>

                  <h2 class="text-3xl md:text-4xl font-extrabold text-white mt-2">
                    {isCurrent ? '2026 & Upcoming' : year}
                  </h2>

                  <p class="text-sm text-slate-400 mt-2">
                    {isCurrent
                      ? 'The latest SyntaX activities and upcoming announcements.'
                      : `A look back at SyntaX events from ${year}.`}
                  </p>
                </div>

                <span class="font-mono text-xs text-slate-500">
                  {String(yearEvents.length).padStart(2, '0')}
                  {yearEvents.length === 1 ? ' EVENT' : ' EVENTS'}
                </span>

              </div>
            </ScrollReveal>

            <!-- EVENT CARDS -->
            {yearEvents.length > 0 ? (
              <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">

                {yearEvents.map((event, index) => (
                  <ScrollReveal animation="fade-up" delay={index * 90}>

                    <article class="card p-5 sm:p-6 h-full flex flex-col group hover:border-cyan-400/40 transition-colors">

                      <a
                        href={`/events/${event.slug}`}
                        class="block overflow-hidden rounded-xl mb-5"
                        aria-label={`View ${event.title}`}
                      >
                        <EventPoster
                          category={event.category}
                          slug={event.slug}
                          className="w-full transition-transform duration-500 group-hover:scale-[1.025]"
                        />
                      </a>

                      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                        <span class={`badge ${getCategoryBadge(event.category)} text-[10px]`}>
                          {event.category}
                        </span>

                        <span class="text-[11px] font-mono text-slate-400">
                          {event.date}
                        </span>
                      </div>

                      <h3 class="text-xl font-bold text-white leading-snug">
                        <a
                          href={`/events/${event.slug}`}
                          class="hover:text-cyan-400 transition-colors"
                        >
                          {event.title}
                        </a>
                      </h3>

                      <p class="mt-3 text-sm text-slate-400 leading-relaxed flex-1">
                        {event.summary}
                      </p>

                      <div class="mt-5 pt-4 border-t border-white/10 flex items-center justify-between gap-3">

                        <span class="text-[11px] font-mono text-slate-500">
                          {event.venue}
                        </span>

                        <a
                          href={`/events/${event.slug}`}
                          class="shrink-0 text-xs font-mono font-bold text-cyan-400 hover:text-white transition-colors"
                        >
                          Explore ↗
                        </a>

                      </div>

                    </article>

                  </ScrollReveal>
                ))}

              </div>
            ) : (

              
              <div class="card p-8 md:p-10 border-dashed text-center">

                <div class="text-3xl mb-3 text-cyan-400">
                  ✳
                </div>

                <h3 class="text-lg font-bold text-white">
                  The {year} archive is being updated.
                </h3>

                <p class="text-sm text-slate-400 mt-2 max-w-xl mx-auto">
                  We’re collecting event details and memories from this edition.
                  Check back soon for the archive.
                </p>

                <a
                  href="https://www.instagram.com/syntax_vnit/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex mt-5 text-xs font-mono font-bold text-cyan-400 hover:text-white"
                >
                  Explore SyntaX on Instagram ↗
                </a>

              </div>

            )}

          </div>
        );
      })}

    </div>
  </section>

</BaseLayout>
