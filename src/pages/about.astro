---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
import AboutDoodles from '../components/illustrations/AboutDoodles.astro';
import WebDevDoodle from '../components/illustrations/WebDevDoodle.astro';
import CPDoodle from '../components/illustrations/CPDoodle.astro';
import AIDoodle from '../components/illustrations/AIDoodle.astro';
import ScrollReveal from '../components/motion/ScrollReveal.astro';
import Ticker from '../components/motion/Ticker.astro';

// Key club statistics
const stats = [
  { num: '2020', label: 'ESTABLISHED', detail: 'Student-initiated at VNIT' },
  { num: '36H', label: 'SYNHACK ARENA', detail: 'Central India flagship clash' },
  { num: '12+', label: 'NATIONAL PODIUMS', detail: 'ICPC & SIH finalists' },
  { num: '600+', label: 'GUILD NETWORK', detail: 'Engineers on campus & industry' },
];

// The 3 operational labs (Compact points)
const disciplines = [
  {
    num: '01',
    code: 'SYS · ARCH',
    title: 'Web & Systems Architecture',
    color: '#2ED3FE',
    doodleType: 'web',
    tag: 'ISLAND HYDRATION',
    points: [
      'Static-first architectures & Island Hydration (0ms TBT)',
      'Distributed edge workers, serverless micro-APIs & WASM',
      'Production open source tooling with zero database bloat',
    ],
    tech: ['TypeScript', 'Astro', 'React', 'Go', 'Edge'],
  },
  {
    num: '02',
    code: 'ALG · RIGOR',
    title: 'Competitive Programming & Rigor',
    color: '#8B5CF6',
    doodleType: 'cp',
    tag: 'ACM-ICPC TRACK',
    points: [
      'Weekly high-speed Codeforces & AtCoder campus clashes',
      'Lazy segment trees, network flows & amortized Big-O purity',
      'Structured training pipeline for ACM-ICPC Regionals',
    ],
    tech: ['C++20', 'Codeforces CM', 'Segment Trees', 'Flow'],
  },
  {
    num: '03',
    code: 'AI · AGENTS',
    title: 'Applied Intelligence & Local Models',
    color: '#10B981',
    doodleType: 'ai',
    tag: 'ON-DEVICE INFERENCE',
    points: [
      '4-bit quantized SLMs executing on local lab hardware',
      'Dense HNSW vector search & campus archive RAG pipelines',
      'Autonomous multi-agent deterministic tool-calling loops',
    ],
    tech: ['PyTorch', 'Quantized SLMs', 'Vector RAG', 'CUDA'],
  },
];

// 4-Stage Club Lifecycle Pipeline
const pipelineSteps = [
  {
    step: 'STAGE 01',
    name: 'THE INTAKE',
    badge: 'OPEN SEAT',
    desc: 'Any undergraduate who writes code. Zero pedigree or resume screening.',
    color: '#2ED3FE',
    note: 'zero gatekeeping',
  },
  {
    step: 'STAGE 02',
    name: 'THE FORGE',
    badge: 'WEEKLY RIGOR',
    desc: 'Weekend workshops, timed contest clashes, and peer code reviews.',
    color: '#8B5CF6',
    note: 'ship to prod',
  },
  {
    step: 'STAGE 03',
    name: 'THE ARENA',
    badge: '36H SYNHACK',
    desc: 'Central India’s flagship hackathon battlefield. Real clocks, real users.',
    color: '#F59E0B',
    note: 'live judging',
  },
  {
    step: 'STAGE 04',
    name: 'THE LEGACY',
    badge: 'LADDER RETURN',
    desc: 'Alumni return mock interviews, code reviews, and direct referrals.',
    color: '#10B981',
    note: 'guild for life',
  },
];

// 4 Pillars of Our Culture (Clean Vector Doodles, Zero Emojis)
const culturePillars = [
  {
    num: '01',
    code: 'OPEN_TO_ALL',
    title: 'Open to All Departments',
    color: '#2ED3FE',
    desc: 'Be it Mechanical, Mining, Civil, Chemical, Electrical, or Metallurgy — everyone is welcome. Curiosity and passion to build are the only criteria.',
    tag: 'ZERO BRANCH BARRIERS',
    doodle: 'community',
  },
  {
    num: '02',
    code: 'BUILD_FOR_VNIT',
    title: 'Build in Public for VNIT',
    color: '#8B5CF6',
    desc: 'We engineer software in public on GitHub with a clear mission: shipping reliable tools and systems that directly improve and modernize the VNIT campus.',
    tag: 'CAMPUS-FIRST OPEN SOURCE',
    doodle: 'campus',
  },
  {
    num: '03',
    code: 'INFRASTRUCTURE',
    title: 'Empowering All VNIT Clubs',
    color: '#F59E0B',
    desc: 'Helping all clubs of VNIT improve their infrastructure by engineering their event portals, voting systems, websites, and technical tooling.',
    tag: 'SHARED DIGITAL INFRA',
    doodle: 'infra',
  },
  {
    num: '04',
    code: 'LIFELONG_GUILD',
    title: 'Active Beyond Graduation',
    color: '#10B981',
    desc: 'Being an active member of the club even after graduation. Our alumni return to mentor junior batches, conduct mock interviews, and share referrals.',
    tag: 'GUILD FOR LIFE',
    doodle: 'guild',
  },
];
---

<BaseLayout
  title={`About SyntaX | ${siteConfig.name}`}
  description="SyntaX is the undergraduate software, algorithms, and artificial intelligence guild of VNIT Nagpur. 100% student-initiated, merit-driven, and public."
>
  <div class="snap-y snap-proximity w-full">

    <!-- ================================================================= -->
    <!-- 1. HERO SECTION: ARTISTIC TYPOGRAPHY + FULL ART DOODLES           -->
    <!-- ================================================================= -->
    <section class="snap-start snap-always scroll-mt-[72px] min-h-[calc(100dvh-72px)] lg:h-[calc(100dvh-72px)] flex flex-col justify-center px-4 sm:px-6 lg:px-8 py-6 lg:py-8 border-b-2 border-white/10 relative overflow-hidden bg-[#07090E]">
      <!-- Ambient organic glow in original SyntaX blue & purple -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[750px] h-[750px] bg-gradient-to-tr from-[#1E75E8]/20 via-[#2ED3FE]/15 to-[#8B5CF6]/20 rounded-full blur-3xl pointer-events-none -z-10"></div>

      <div class="container my-auto relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
          
          <!-- Left Column: Highly Artistic Typography (Pure brand statement, zero clutter) -->
          <div class="lg:col-span-7 space-y-5">
            
            <!-- Badges -->
            <ScrollReveal animation="fade-up" delay={40}>
              <div class="flex flex-wrap items-center gap-3">
                <AboutDoodles type="stamp-merit" />
                <AboutDoodles type="stamp-public" />
                <AboutDoodles type="sticker-ship-it" />
                <AboutDoodles type="sticker-algo" />
              </div>
            </ScrollReveal>

            <!-- Artistic Typography Centerpiece -->
            <ScrollReveal animation="fade-up" delay={100}>
              <div class="space-y-2">
                <!-- Editorial Subhead with Curvy Typography -->
                <div class="flex items-center gap-3 text-slate-400 font-mono text-xs sm:text-sm uppercase tracking-[0.25em]">
                  <span class="font-curvy text-2xl font-bold text-[#2ED3FE] tracking-wide">Est. 2020</span>
                  <span class="h-px w-8 bg-slate-600"></span>
                  <span class="font-serif italic lowercase text-base sm:text-xl text-slate-300">the undergraduate guild</span>
                </div>
                
                <!-- SYNTAX NAME IN ITS ORIGINAL COLORS: BLUE AND PURPLE -->
                <h1 class="text-6xl sm:text-8xl md:text-9xl lg:text-[10rem] font-black tracking-tighter uppercase leading-[0.85] select-none my-1">
                  <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#1E75E8] via-[#2ED3FE] to-[#8B5CF6] filter drop-shadow-[0_0_55px_rgba(46,211,254,0.4)]">
                    SYNTAX
                  </span>
                </h1>

                <!-- Serif Editorial Tagline -->
                <p class="font-serif italic text-lg sm:text-2xl text-slate-300 font-normal leading-relaxed max-w-xl pt-1">
                  Where ideas turn into interfaces, and hard computational problems turn into possibilities.
                </p>

                <!-- Hand-drawn scribble underline doodle -->
                <div class="pt-2">
                  <AboutDoodles type="scribble-underline" color="#8B5CF6" className="w-64 sm:w-80" />
                </div>
              </div>
            </ScrollReveal>

          </div>

          <!-- Right Column: FULL AUTHENTIC LOGO WITH PLAYFUL FLOATING ART DOODLES MAKING IT POP -->
          <div class="lg:col-span-5 flex justify-center items-center relative">
            <ScrollReveal animation="scale-in" delay={120}>
              <div class="relative flex justify-center items-center py-4">
                
                <!-- Ambient Glow in Original Blue & Purple -->
                <div class="absolute w-72 h-72 sm:w-96 sm:h-96 bg-gradient-to-tr from-[#1E75E8]/25 via-[#2ED3FE]/20 to-[#8B5CF6]/25 rounded-full blur-3xl pointer-events-none -z-10 animate-pulse-glow"></div>

                <!-- Floating Hand-Drawn Technology Doodles Around Logo -->
                <div class="absolute -top-4 -left-4 z-20 animate-float pointer-events-none">
                  <AboutDoodles type="star-sparkle" color="#2ED3FE" size={32} />
                </div>
                <div class="absolute -top-6 -right-2 z-20 animate-float pointer-events-none" style="animation-delay: 1.5s;">
                  <AboutDoodles type="code-braces" color="#8B5CF6" size={36} />
                </div>
                <div class="absolute -bottom-3 -left-6 z-20 animate-float pointer-events-none hidden sm:block" style="animation-delay: 2.2s;">
                  <AboutDoodles type="tech-react" className="shadow-[2px_2px_0px_#2ED3FE] rotate-[-4deg]" />
                </div>
                <div class="absolute -bottom-4 -right-4 z-20 animate-float pointer-events-none hidden sm:block" style="animation-delay: 0.9s;">
                  <AboutDoodles type="tech-python" className="shadow-[2px_2px_0px_#F59E0B] rotate-[5deg]" />
                </div>
                <div class="absolute top-1/2 -right-8 -translate-y-1/2 z-20 animate-pulse-glow pointer-events-none hidden md:block">
                  <AboutDoodles type="lightning-doodle" color="#FBBF24" size={26} />
                </div>
                <div class="absolute top-1/3 -left-8 z-20 animate-float pointer-events-none hidden md:block" style="animation-delay: 3s;">
                  <AboutDoodles type="star-sparkle" color="#8B5CF6" size={24} />
                </div>

                <!-- THE AUTHENTIC SYNTAX LOGO (FULL UNCONSTRAINED TRANSPARENT IMAGE) -->
                <img
                  src="/logo/syntax-logo.png"
                  alt="SyntaX VNIT Official Inverted S Logo"
                  width="440"
                  height="440"
                  class="max-h-[42vh] sm:max-h-[48vh] lg:max-h-[52vh] w-auto max-w-[340px] sm:max-w-[400px] lg:max-w-[440px] object-contain filter drop-shadow-[0_0_45px_rgba(46,211,254,0.45)] hover:scale-105 transition-transform duration-500 select-none relative z-10"
                />

                <!-- Hand-drawn Curvy Note Below Logo -->
                <div class="absolute -bottom-6 left-1/2 -translate-x-1/2 z-20 whitespace-nowrap pointer-events-none">
                  <span class="font-curvy text-lg sm:text-xl text-slate-300 font-bold tracking-wide">
                    VNIT's open source nerve center ⚡
                  </span>
                </div>
              </div>
            </ScrollReveal>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 2. THE THREE DISCIPLINE LABS: PROPERLY POSITIONED & NEVER CUT OFF -->
    <!-- ================================================================= -->
    <section id="disciplines" class="snap-start snap-always scroll-mt-[72px] min-h-[calc(100dvh-72px)] flex flex-col justify-center px-4 sm:px-6 lg:px-8 py-8 lg:py-10 border-b-2 border-white/10 bg-[#07090E] relative overflow-hidden">
      
      <!-- Section Header -->
      <div class="container shrink-0 mb-5">
        <ScrollReveal animation="fade-up" delay={30}>
          <div class="flex items-center justify-between">
            <div class="space-y-1">
              <div class="font-curvy text-2xl sm:text-3xl font-bold tracking-wide text-[#2ED3FE] leading-none mb-1">
                Three Operational Tracks
              </div>
              <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white uppercase tracking-tight">
                WHAT WE <span class="text-gradient">ENGINEER.</span>
              </h2>
            </div>
            
            <!-- Tech badges doodle cluster replacing the arrow -->
            <div class="hidden sm:flex items-center gap-2 select-none">
              <AboutDoodles type="tech-react" />
              <AboutDoodles type="tech-cpp" />
              <AboutDoodles type="tech-go" />
            </div>
          </div>
        </ScrollReveal>
      </div>

      <!-- 3-Column Brutalist Visual Grid (Cleanly sized so it never overflows or cuts off) -->
      <div class="container my-auto">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 lg:gap-6">
          {disciplines.map((d, idx) => (
            <ScrollReveal animation="fade-up" delay={idx * 80}>
              <div class="p-4 sm:p-5 border-2 border-white/15 bg-[#0B0F19] flex flex-col justify-between h-full relative group hover:border-[#2ED3FE] transition-colors shadow-[4px_4px_0px_rgba(255,255,255,0.05)] hover:shadow-[4px_4px_0px_#2ED3FE]">
                
                <div>
                  <!-- Header Badge -->
                  <div class="flex items-center justify-between font-mono text-xs mb-2.5 pb-2 border-b border-white/10">
                    <span class="font-extrabold text-sm" style={`color: ${d.color}`}>
                      {d.num} · {d.code}
                    </span>
                    <span class="px-2 py-0.5 bg-white/[0.05] border border-white/10 text-slate-300 text-[10px]">
                      {d.tag}
                    </span>
                  </div>

                  <!-- Scaled Visual Doodle Diagram -->
                  <div class="mb-3 flex justify-center p-2 bg-[#07090E] border border-white/10 relative overflow-hidden">
                    {d.doodleType === 'web' && <WebDevDoodle className="max-h-[110px] sm:max-h-[125px] w-auto mx-auto" />}
                    {d.doodleType === 'cp' && <CPDoodle className="max-h-[110px] sm:max-h-[125px] w-auto mx-auto" />}
                    {d.doodleType === 'ai' && <AIDoodle className="max-h-[110px] sm:max-h-[125px] w-auto mx-auto" />}
                  </div>

                  <!-- Track Name -->
                  <h3 class="text-lg sm:text-xl font-extrabold text-white uppercase tracking-tight group-hover:text-[#2ED3FE] transition-colors mb-2">
                    {d.title}
                  </h3>

                  <!-- 3 Points -->
                  <ul class="space-y-1 text-xs text-slate-300">
                    {d.points.map((pt) => (
                      <li class="flex items-start gap-1.5">
                        <span class="font-bold shrink-0 mt-0.5" style={`color: ${d.color}`}>▸</span>
                        <span class="leading-snug">{pt}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Tech Stack Pills Footer -->
                <div class="mt-3.5 pt-2 border-t border-white/10 flex flex-wrap gap-1 font-mono text-[10px]">
                  {d.tech.map((t) => (
                    <span class="px-2 py-0.5 bg-white/[0.04] border border-white/10 text-slate-400">
                      #{t}
                    </span>
                  ))}
                </div>
              </div>
            </ScrollReveal>
          ))}
        </div>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 3. HOW SYNTAX OPERATES: 4-STAGE LIFECYCLE                         -->
    <!-- ================================================================= -->
    <section id="lifecycle" class="snap-start snap-always scroll-mt-[72px] min-h-[calc(100dvh-72px)] flex flex-col justify-between px-4 sm:px-6 lg:px-8 py-8 lg:py-10 border-b-2 border-white/10 bg-[#0B0F19] relative overflow-hidden">
      
      <!-- Section Header with Curvy Typography -->
      <div class="container shrink-0 mb-4">
        <ScrollReveal animation="fade-up" delay={30}>
          <div class="flex items-center justify-between">
            <div class="space-y-0.5">
              <div class="font-curvy text-2xl sm:text-3xl font-bold tracking-wide text-[#F59E0B] leading-none mb-1">
                Operating Lifecycle
              </div>
              <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white uppercase tracking-tight">
                HOW SYNTAX <span class="text-gradient">OPERATES.</span>
              </h2>
            </div>
            
            <!-- Playful tech sparkle doodle -->
            <div class="hidden sm:flex items-center gap-2 select-none">
              <AboutDoodles type="star-sparkle" color="#F59E0B" size={26} />
              <span class="font-curvy text-lg text-amber-300/80 font-bold">four sequential stages</span>
            </div>
          </div>
        </ScrollReveal>
      </div>

      <!-- 4 Stages Grid Across Screen with Hand-Drawn Technology Vector Doodles -->
      <div class="container my-auto">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-5">
          {pipelineSteps.map((p, idx) => (
            <ScrollReveal animation="fade-up" delay={idx * 80}>
              <div class="p-5 border-2 border-white/15 bg-[#07090E] h-full flex flex-col justify-between relative group hover:border-[#2ED3FE] transition-colors shadow-[4px_4px_0px_rgba(255,255,255,0.05)]">
                <!-- Large Numeral Watermark -->
                <span class="font-mono text-4xl font-black text-white/5 absolute top-3 right-4 select-none">
                  0{idx + 1}
                </span>

                <div>
                  <div class="flex items-center justify-between font-mono text-[11px] mb-3 pb-2 border-b border-white/10">
                    <span class="font-bold" style={`color: ${p.color}`}>
                      {p.step}
                    </span>
                    <span class="px-2 py-0.5 bg-white/[0.05] border border-white/10 text-slate-300 text-[10px]">
                      {p.badge}
                    </span>
                  </div>

                  <!-- Bespoke Hand-Drawn Vector Technology Doodle for Each Stage -->
                  <div class="my-3 flex items-center justify-center p-3 bg-[#0B0F19] border border-white/5 rounded-lg group-hover:border-[#2ED3FE]/30 transition-colors">
                    {idx === 0 && (
                      <svg class="w-12 h-12" viewBox="0 0 44 44" fill="none">
                        <path d="M10 14 L4 22 L10 30" stroke="#2ED3FE" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M34 14 L40 22 L34 30" stroke="#2ED3FE" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M25 10 L19 34" stroke="#2ED3FE" stroke-width="2.2" stroke-linecap="round"/>
                        <circle cx="22" cy="22" r="3" fill="#2ED3FE" opacity="0.6"/>
                      </svg>
                    )}
                    {idx === 1 && (
                      <svg class="w-12 h-12" viewBox="0 0 44 44" fill="none">
                        <path d="M22 6 C22 6, 14 16, 14 26 C14 32, 18 36, 22 36 C26 36, 30 32, 30 26 C30 16, 22 6, 22 6 Z" stroke="#8B5CF6" stroke-width="2.2" fill="#8B5CF6" fill-opacity="0.15"/>
                        <circle cx="22" cy="20" r="3" fill="#C084FC"/>
                        <path d="M14 26 L8 32 L12 36 L15 33" stroke="#8B5CF6" stroke-width="2" stroke-linejoin="round"/>
                        <path d="M30 26 L36 32 L32 36 L29 33" stroke="#8B5CF6" stroke-width="2" stroke-linejoin="round"/>
                        <line x1="22" y1="36" x2="22" y2="42" stroke="#F59E0B" stroke-width="2.5" stroke-linecap="round"/>
                      </svg>
                    )}
                    {idx === 2 && (
                      <svg class="w-12 h-12" viewBox="0 0 44 44" fill="none">
                        <path d="M12 10 H32 V20 C32 26, 28 30, 22 30 C16 30, 12 26, 12 20 V10 Z" stroke="#F59E0B" stroke-width="2.2" fill="#F59E0B" fill-opacity="0.15"/>
                        <path d="M12 14 H6 C6 20, 10 22, 12 22" stroke="#F59E0B" stroke-width="2"/>
                        <path d="M32 14 H38 C38 20, 34 22, 32 22" stroke="#F59E0B" stroke-width="2"/>
                        <path d="M22 30 V36 M16 36 H28" stroke="#F59E0B" stroke-width="2.2" stroke-linecap="round"/>
                      </svg>
                    )}
                    {idx === 3 && (
                      <svg class="w-12 h-12" viewBox="0 0 44 44" fill="none">
                        <circle cx="22" cy="14" r="6" stroke="#10B981" stroke-width="2.2" fill="#10B981" fill-opacity="0.15"/>
                        <circle cx="10" cy="32" r="5" stroke="#10B981" stroke-width="2" fill="#10B981" fill-opacity="0.15"/>
                        <circle cx="34" cy="32" r="5" stroke="#10B981" stroke-width="2" fill="#10B981" fill-opacity="0.15"/>
                        <path d="M18 19 L13 28 M26 19 L31 28" stroke="#10B981" stroke-width="2" stroke-dasharray="2 2"/>
                        <path d="M16 32 L28 32" stroke="#10B981" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    )}
                  </div>

                  <h3 class="text-lg font-extrabold text-white uppercase tracking-tight mb-2">
                    {p.name}
                  </h3>

                  <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                    {p.desc}
                  </p>
                </div>

                <div class="mt-4 pt-2.5 border-t border-white/10 flex items-center justify-between">
                  <span class="font-curvy text-base font-bold" style={`color: ${p.color}`}>{p.note}</span>
                  <span class="text-[#2ED3FE] font-mono text-xs font-bold">→ ADVANCE</span>
                </div>
              </div>
            </ScrollReveal>
          ))}
        </div>
      </div>

      <!-- Compact Ethos Ticker at Section Bottom -->
      <div class="w-full shrink-0 pt-4 border-t border-white/10">
        <Ticker
          items={[
            'COMPUTE FROM FIRST PRINCIPLES',
            'NO VANITY CERTIFICATES',
            'STRICTLY CODE',
            'ALGORITHMIC PURITY',
            'ZERO GATEKEEPING',
            'SHIP TO PRODUCTION',
            '36H SYNHACK ARENA',
          ]}
          speed={24}
          variant="default"
        />
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 4. BY THE NUMBERS & OUR CULTURE                                   -->
    <!-- ================================================================= -->
    <section id="culture" class="snap-start snap-always scroll-mt-[72px] min-h-[calc(100dvh-72px)] flex flex-col justify-center px-4 sm:px-6 lg:px-8 py-8 lg:py-10 border-b-2 border-white/10 bg-[#07090E] relative overflow-hidden">
      
      <!-- Section Header: OUR CULTURE with Curvy Typography -->
      <div class="container shrink-0 mb-4">
        <ScrollReveal animation="fade-up" delay={30}>
          <div class="flex items-center justify-between">
            <div class="space-y-0.5">
              <div class="font-curvy text-2xl sm:text-3xl font-bold tracking-wide text-[#10B981] leading-none mb-1">
                The SyntaX DNA
              </div>
              <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white uppercase tracking-tight">
                OUR <span class="text-gradient">CULTURE.</span>
              </h2>
            </div>
            
            <!-- Code braces doodle cluster replacing the arrow -->
            <div class="hidden sm:flex items-center gap-2 select-none">
              <AboutDoodles type="code-braces" color="#10B981" size={28} />
              <span class="font-curvy text-emerald-400 text-lg font-bold">first principles only</span>
            </div>
          </div>
        </ScrollReveal>
      </div>

      <!-- Numbers Row + 4 Culture Cards Combined on Single Screen -->
      <div class="container my-auto space-y-4">
        
        <!-- Top Metrics Strip -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
          {stats.map((s, idx) => (
            <ScrollReveal animation="fade-up" delay={idx * 60}>
              <div class="p-3 sm:p-4 border-l-2 border-[#2ED3FE] pl-4 bg-[#0B0F19] border-t border-r border-b border-white/10">
                <div class="font-mono text-2xl sm:text-4xl font-black text-white tracking-tight">
                  {s.num}
                </div>
                <div class="font-mono text-[10px] sm:text-xs font-extrabold text-[#2ED3FE] uppercase tracking-wider">
                  {s.label}
                </div>
                <div class="text-[11px] text-slate-400 font-mono hidden sm:block">
                  {s.detail}
                </div>
              </div>
            </ScrollReveal>
          ))}
        </div>

        <!-- 4 Culture Cards (Clean Vector Doodles, No Emojis, Curvy Headers) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
          {culturePillars.map((c, i) => (
            <ScrollReveal animation="fade-up" delay={i * 70}>
              <div class="p-4 sm:p-5 border-2 border-white/15 bg-[#0B0F19] relative shadow-[3px_3px_0px_rgba(255,255,255,0.05)] hover:border-[#2ED3FE] transition-colors h-full flex flex-col justify-between">
                <span class="font-mono text-3xl font-black text-white/5 absolute top-2 right-3 select-none">
                  {c.num}
                </span>

                <div>
                  <div class="flex items-center gap-2.5 mb-2.5 pb-2 border-b border-white/10">
                    <div class="p-1.5 rounded-lg bg-white/[0.04] border border-white/10 shrink-0">
                      {c.doodle === 'community' && (
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#2ED3FE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                          <circle cx="9" cy="7" r="4"></circle>
                          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                      )}
                      {c.doodle === 'campus' && (
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <line x1="3" y1="21" x2="21" y2="21"></line>
                          <line x1="9" y1="8" x2="10" y2="8"></line>
                          <line x1="14" y1="8" x2="15" y2="8"></line>
                          <line x1="9" y1="12" x2="10" y2="12"></line>
                          <line x1="14" y1="12" x2="15" y2="12"></line>
                          <path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"></path>
                        </svg>
                      )}
                      {c.doodle === 'infra' && (
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                        </svg>
                      )}
                      {c.doodle === 'guild' && (
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4Zm0 0c2 2.67 4 4 6 4a4 4 0 1 0 0-8c-2 0-4 1.33-6 4Z"></path>
                        </svg>
                      )}
                    </div>
                    <span class="font-curvy text-lg font-bold tracking-wide" style={`color: ${c.color}`}>
                      Pillar {c.num}
                    </span>
                  </div>

                  <h3 class="text-base font-extrabold text-white uppercase tracking-tight mb-2">
                    {c.title}
                  </h3>

                  <p class="text-xs text-slate-300 leading-relaxed">
                    {c.desc}
                  </p>
                </div>

                <div class="mt-3.5 pt-2 border-t border-white/10 font-mono text-[10px] text-slate-400 flex items-center justify-between">
                  <span style={`color: ${c.color}`}>#{c.tag}</span>
                  <span class="text-slate-500 font-curvy text-sm">active DNA</span>
                </div>
              </div>
            </ScrollReveal>
          ))}
        </div>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- 5. FINAL CALL TO ACTION: FULLY VISIBLE AT ONCE WITH POPPING ART   -->
    <!-- ================================================================= -->
    <section id="join" class="snap-start snap-always scroll-mt-[72px] min-h-[calc(100dvh-72px)] flex flex-col justify-center px-4 sm:px-6 lg:px-8 py-8 bg-[#0B0F19] text-center relative overflow-hidden">
      <!-- Ambient Glow -->
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#2ED3FE]/5 to-transparent pointer-events-none"></div>

      <!-- Floating Technology Doodles Framing Call to Action -->
      <div class="absolute top-1/4 left-8 animate-float pointer-events-none hidden lg:block">
        <AboutDoodles type="rocket-coder-art" color="#2ED3FE" className="w-24 h-24 opacity-80 rotate-[-12deg]" />
      </div>
      <div class="absolute bottom-1/4 right-8 animate-float pointer-events-none hidden lg:block" style="animation-delay: 2s;">
        <AboutDoodles type="robot-companion-art" color="#8B5CF6" className="w-24 h-24 opacity-80 rotate-[8deg]" />
      </div>
      <div class="absolute top-12 right-24 animate-pulse-glow pointer-events-none hidden md:block">
        <AboutDoodles type="star-sparkle" color="#F59E0B" size={32} />
      </div>
      <div class="absolute bottom-16 left-28 animate-float pointer-events-none hidden md:block" style="animation-delay: 1.5s;">
        <AboutDoodles type="code-braces" color="#10B981" size={36} />
      </div>

      <!-- Centered Call to Action Content -->
      <div class="container max-w-3xl my-auto space-y-6 relative z-10">
        <!-- Top Sticker -->
        <ScrollReveal animation="fade-up">
          <div class="inline-flex items-center gap-2 border-2 border-[#2ED3FE] px-4 py-1.5 font-mono text-xs font-extrabold text-[#2ED3FE] uppercase tracking-widest bg-[#07090E] shadow-[3px_3px_0px_#2ED3FE]">
            <AboutDoodles type="lightning-doodle" color="#F59E0B" size={16} />
            <span>THE LAB BENCH IS OPEN</span>
            <AboutDoodles type="lightning-doodle" color="#F59E0B" size={16} />
          </div>
        </ScrollReveal>

        <!-- Artistic Headline in Original Blue & Purple -->
        <ScrollReveal animation="fade-up" delay={120}>
          <h2 class="text-4xl sm:text-6xl md:text-7xl font-black text-white tracking-tight uppercase leading-[0.95]">
            BUILD WITH <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#1E75E8] via-[#2ED3FE] to-[#8B5CF6]">
              SYNTAX VNIT.
            </span>
          </h2>
        </ScrollReveal>

        <!-- Curvy Callout Note -->
        <ScrollReveal animation="fade-up" delay={150}>
          <p class="font-curvy text-2xl sm:text-3xl text-[#2ED3FE] font-bold">
            No branch barriers · Strictly merit · Open source for VNIT
          </p>
        </ScrollReveal>

        <!-- Checklist Chips -->
        <ScrollReveal animation="fade-up" delay={180}>
          <div class="flex flex-wrap justify-center gap-3 text-xs sm:text-sm font-mono text-slate-300">
            <span class="px-3 py-1 bg-white/[0.04] border border-white/10">✓ Open Community Workshops</span>
            <span class="px-3 py-1 bg-white/[0.04] border border-white/10">✓ Weekly Contest Clashes</span>
            <span class="px-3 py-1 bg-white/[0.04] border border-white/10">✓ SynHack 36H Arena</span>
          </div>
        </ScrollReveal>

        <!-- Action Buttons -->
        <ScrollReveal animation="fade-up" delay={240}>
          <div class="flex flex-wrap justify-center items-center gap-4 pt-2">
            <a href="/events" class="btn btn-primary text-xs font-mono py-3.5 px-8 tracking-wider shadow-[4px_4px_0px_#2ED3FE]">
              <span>VIEW EVENT SCHEDULE</span>
              <span>→</span>
            </a>
            <a
              href={siteConfig.socials.github || "https://github.com/syntaxvnit"}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary text-xs font-mono py-3.5 px-7 tracking-wider"
            >
              <span>GITHUB ORGANIZATION</span>
              <span>↗</span>
            </a>
          </div>
        </ScrollReveal>
      </div>
    </section>

  </div>
</BaseLayout>
