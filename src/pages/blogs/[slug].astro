---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogPosts, type BlogPost } from '../../data/blogs';
import ScrollReveal from '../../components/motion/ScrollReveal.astro';
import JournalDiagram from '../../components/illustrations/JournalDiagram.astro';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

// Find other related articles
const relatedPosts = blogPosts.filter((b) => b.slug !== post.slug).slice(0, 2);

function getCategoryColor(category: string) {
  switch (category) {
    case 'Systems': return 'bg-blue-500/10 text-blue-300 border-blue-500/30';
    case 'Algorithms': return 'bg-purple-500/10 text-purple-300 border-purple-500/30';
    case 'AI & ML': return 'bg-cyan-500/10 text-[#2ED3FE] border-cyan-500/30';
    case 'Tutorial': return 'bg-amber-500/10 text-amber-300 border-amber-500/30';
    default: return 'bg-white/5 text-stone-300 border-white/10';
  }
}
---

<BaseLayout
  title={`${post.title} | SyntaX Technical Journal`}
  description={post.summary}
>
  <article class="section pt-8 pb-16">
    <div class="container max-w-3xl">
      <!-- Breadcrumb -->
      <ScrollReveal animation="fade-up" delay={50}>
        <nav class="mb-6 font-mono text-xs text-[var(--color-ink-tertiary)] flex items-center gap-2" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/blogs" class="hover:text-white transition-colors">Journal</a>
          <span>/</span>
          <span class="text-[#2ED3FE] font-bold">{post.category}</span>
        </nav>
      </ScrollReveal>

      <!-- Article Header -->
      <ScrollReveal animation="fade-up" delay={150}>
        <header class="mb-10">
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <span class={`px-2.5 py-1 rounded-md text-xs font-mono font-bold border ${getCategoryColor(post.category)}`}>
              {post.category.toUpperCase()}
            </span>
            <span class="font-mono text-xs text-[var(--color-ink-tertiary)] font-bold">
              {post.publishedAt} · {post.readTime}
            </span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-serif font-bold text-white leading-tight">
            {post.title}
          </h1>

          <p class="mt-4 text-xl text-[var(--color-ink-secondary)] leading-relaxed font-serif italic border-l-2 border-l-[#2ED3FE] pl-4">
            "{post.summary}"
          </p>

          <!-- Author Card -->
          <div class="mt-8 p-4 rounded-xl bg-[#0E131F]/80 border border-white/10 flex items-center justify-between backdrop-blur-xl">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#2ED3FE] to-[#8B5CF6] p-0.5 shadow-[0_0_15px_rgba(46,211,254,0.25)]">
                <div class="w-full h-full rounded-full bg-[#0B0F19] flex items-center justify-center font-serif font-bold text-lg text-white">
                  {post.author.name.charAt(0)}
                </div>
              </div>
              <div>
                <div class="font-bold text-sm text-white">{post.author.name}</div>
                <div class="text-xs text-[#2ED3FE] font-mono font-semibold">{post.author.role}</div>
              </div>
            </div>

            {post.author.slug && (
              <a href={`/people/${post.author.slug}`} class="text-xs font-mono font-bold text-white hover:text-[#2ED3FE] transition-colors flex items-center gap-1">
                <span>Author Bio</span>
                <span>→</span>
              </a>
            )}
          </div>
        </header>
      </ScrollReveal>

      <!-- Editorial Architectural Diagram & Figure -->
      <ScrollReveal animation="fade-up" delay={200}>
        <div class="my-8 flex justify-center">
          <JournalDiagram category={post.category} slug={post.slug} className="w-full shadow-2xl" />
        </div>
      </ScrollReveal>

      <!-- Article Body with rich editorial typography -->
      <ScrollReveal animation="fade-up" delay={250}>
        <div class="article-content font-sans text-base leading-relaxed text-stone-200 bg-[#0E131F]/60 p-8 md:p-12 rounded-2xl border border-white/10 backdrop-blur-xl shadow-xl">
          {post.content.split('\n\n').map((block) => {
            const trimmed = block.trim();
            if (!trimmed) return null;

            if (trimmed.startsWith('### ')) {
              return <h3 class="text-2xl font-serif font-bold mt-10 mb-4 text-white">{trimmed.replace('### ', '')}</h3>;
            }
            if (trimmed.startsWith('## ')) {
              return <h2 class="text-3xl font-serif font-bold mt-12 mb-4 text-white border-b border-white/10 pb-2">{trimmed.replace('## ', '')}</h2>;
            }
            if (trimmed.startsWith('```')) {
              const lines = trimmed.split('\n');
              const codeLines = lines.slice(1, -1).join('\n');
              return (
                <div class="my-6 rounded-xl overflow-hidden border border-white/10 bg-[#0B0F19]">
                  <div class="bg-[#07090E] px-4 py-2 font-mono text-[11px] text-[#A0ACB2] flex items-center justify-between border-b border-white/10">
                    <span>SOURCE SNIPPET</span>
                    <span class="text-emerald-400 font-bold">● C++ / TS</span>
                  </div>
                  <pre class="p-4 text-[#F7F5F0] overflow-x-auto text-xs font-mono leading-relaxed bg-[#0B0F19]"><code>{codeLines}</code></pre>
                </div>
              );
            }
            if (trimmed.startsWith('> ')) {
              return <blockquote class="my-6 pl-4 border-l-4 border-l-[#2ED3FE] italic font-serif text-lg text-stone-200 bg-white/[0.03] p-4 rounded-r-xl">{trimmed.replace('> ', '')}</blockquote>;
            }
            if (trimmed.startsWith('- ')) {
              const items = trimmed.split('\n- ');
              return (
                <ul class="my-4 space-y-2 list-disc list-inside text-stone-300">
                  {items.map((item) => (
                    <li>{item.replace(/^- /, '')}</li>
                  ))}
                </ul>
              );
            }
            if (trimmed.match(/^\d+\. /)) {
              const items = trimmed.split(/\n\d+\. /);
              return (
                <ol class="my-4 space-y-2 list-decimal list-inside text-stone-300">
                  {items.map((item) => (
                    <li>{item.replace(/^\d+\. /, '')}</li>
                  ))}
                </ol>
              );
            }

            return <p class="my-4 text-stone-300 leading-relaxed text-base">{trimmed}</p>;
          })}
        </div>
      </ScrollReveal>

      <!-- Tags & Share Footer -->
      <ScrollReveal animation="fade-up" delay={300}>
        <footer class="mt-8 p-6 rounded-xl bg-[#0E131F]/60 border border-white/10 flex flex-wrap items-center justify-between gap-4 backdrop-blur-xl">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-mono font-bold text-[var(--color-ink-tertiary)]">TOPICS:</span>
            {post.tags.map((tag) => (
              <span class="badge bg-white/5 text-xs font-mono border border-white/10 text-stone-300">
                #{tag}
              </span>
            ))}
          </div>
          <a href="/blogs" class="btn btn-secondary font-mono text-xs py-2 px-4">
            ← Back to All Articles
          </a>
        </footer>
      </ScrollReveal>

      <!-- Related Posts -->
      {relatedPosts.length > 0 && (
        <ScrollReveal animation="fade-up" delay={350}>
          <section class="mt-16 pt-10 border-t border-white/10">
            <span class="section-label">CONTINUE READING</span>
            <h2 class="text-2xl font-serif font-bold mb-6 text-white">More from the Technical Journal</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {relatedPosts.map((related) => (
                <div class="card p-6 bg-[#0E131F]/60 hover:border-[#2ED3FE]/40 border border-white/10 rounded-2xl backdrop-blur-xl transition-all shadow-lg group">
                  <span class={`px-2 py-0.5 rounded text-[10px] font-mono font-bold border inline-block mb-3 ${getCategoryColor(related.category)}`}>
                    {related.category}
                  </span>
                  <h3 class="text-lg font-bold font-serif text-white group-hover:text-[#2ED3FE] transition-colors">
                    <a href={`/blogs/${related.slug}`}>
                      {related.title}
                    </a>
                  </h3>
                  <p class="text-xs text-[var(--color-ink-secondary)] mt-2 line-clamp-2 leading-relaxed">
                    {related.summary}
                  </p>
                </div>
              ))}
            </div>
          </section>
        </ScrollReveal>
      )}
    </div>
  </article>
</BaseLayout>
