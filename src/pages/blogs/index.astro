---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogPosts, getFeaturedBlog } from '../../data/blogs';
import ScrollReveal from '../../components/motion/ScrollReveal.astro';
import Ticker from '../../components/motion/Ticker.astro';
import HandDrawnArrow from '../../components/illustrations/HandDrawnArrow.astro';
import JournalDiagram from '../../components/illustrations/JournalDiagram.astro';

const featured = getFeaturedBlog();
const regularPosts = blogPosts.filter((b) => b.slug !== featured.slug);

function getCategoryColor(category: string) {
  switch (category) {
    case 'Systems': return 'bg-blue-500/10 text-blue-300 border-blue-500/30';
    case 'Algorithms': return 'bg-purple-500/10 text-purple-300 border-purple-500/30';
    case 'AI & ML': return 'bg-cyan-500/10 text-[#2ED3FE] border-cyan-500/30';
    case 'Tutorial': return 'bg-amber-500/10 text-amber-300 border-amber-500/30';
    default: return 'bg-white/5 text-stone-300 border-white/10';
  }
}
---

<BaseLayout
  title="Technical Journal | SyntaX VNIT"
  description="Deep-dive technical essays, systems architecture explorations, and algorithmic breakdowns by student engineers at SyntaX VNIT."
>
  <!-- 1. EDITORIAL HEADER -->
  <section class="section pb-8 pt-8">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-8">
          <ScrollReveal animation="fade-up" delay={100}>
            <div class="inline-flex items-center gap-2 mb-4">
              <span class="badge badge-brand font-mono text-[11px] shadow-[0_0_12px_rgba(46,211,254,0.25)]">DISPATCHES & EDITORIALS</span>
              <span class="font-mono text-xs text-[var(--color-ink-tertiary)]">STUDENT AUTHORED</span>
            </div>
          </ScrollReveal>

          <ScrollReveal animation="fade-up" delay={200}>
            <h1 class="text-4xl md:text-6xl font-serif font-bold text-white leading-tight">
              The Technical <span class="text-gradient">Journal.</span>
            </h1>
          </ScrollReveal>

          <ScrollReveal animation="fade-up" delay={300}>
            <p class="mt-4 text-xl leading-relaxed text-[var(--color-ink-secondary)] max-w-2xl">
              Long-form engineering essays and algorithmic breakdowns written by student practitioners. We write about the architectures we deploy, the bugs we triage, and the mathematical intuition behind complex algorithms.
            </p>
          </ScrollReveal>

          <ScrollReveal animation="fade-up" delay={400}>
            <div class="mt-6 flex items-center gap-3">
              <HandDrawnArrow direction="straight-right" color="#2ED3FE" />
              <span class="font-serif italic text-sm text-[var(--color-ink-secondary)]">
                Peer-reviewed technical contributions from club members
              </span>
            </div>
          </ScrollReveal>
        </div>

        <div class="lg:col-span-4 flex justify-center">
          <ScrollReveal animation="scale-in" delay={350}>
            <div class="p-6 rounded-2xl bg-[#0E131F]/80 border border-white/10 backdrop-blur-xl shadow-2xl text-center max-w-xs relative overflow-hidden">
              <div class="absolute -top-10 -right-10 w-32 h-32 bg-cyan-500/10 rounded-full blur-2xl pointer-events-none"></div>
              <div class="font-mono text-xs text-[#2ED3FE] font-bold uppercase mb-1">
                Editorial Thesis
              </div>
              <div class="font-serif font-bold text-lg text-white">
                First-Hand Knowledge
              </div>
              <p class="font-serif italic text-xs text-[var(--color-ink-secondary)] mt-1.5 leading-relaxed">
                "No generic aggregate summaries—strictly real implementations and verified benchmarks."
              </p>
              <div class="mt-4 pt-3 border-t border-white/10 font-mono text-[10px] text-[#2ED3FE] font-bold">
                {blogPosts.length} PUBLISHED ESSAYS
              </div>
            </div>
          </ScrollReveal>
        </div>
      </div>
    </div>
  </section>

  <!-- TICKER -->
  <Ticker
    items={['Systems Architecture', 'Lazy Segment Trees', 'RAG Vector Search', 'Island Hydration', 'eBPF Tracing', 'Quantized Models', 'Web Performance']}
    variant="default"
    speed={35}
  />

  <!-- 2. FEATURED COVER STORY (MAGAZINE LEAD) -->
  <section class="section pt-10 pb-12">
    <div class="container">
      <ScrollReveal animation="fade-up">
        <div class="border-b border-white/10 pb-4 mb-8 flex items-center justify-between">
          <div>
            <span class="badge badge-brand text-[10px]">COVER ESSAY</span>
            <h2 class="text-2xl font-serif font-bold mt-1 text-white">Featured Lead Story</h2>
          </div>
        </div>

        <article class="card p-8 md:p-12 bg-gradient-to-br from-[#0E131F]/90 to-[#0A0D14]/90 border border-white/10 rounded-3xl backdrop-blur-xl shadow-2xl hover:border-[#2ED3FE]/40 transition-all duration-300 relative overflow-hidden group">
          <div class="absolute -top-24 -right-24 w-80 h-80 bg-gradient-to-br from-[#2ED3FE]/10 to-[#8B5CF6]/15 rounded-full blur-3xl pointer-events-none"></div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
            <div class="lg:col-span-7">
              <div class="flex flex-wrap items-center gap-3 mb-4">
                <span class={`px-2.5 py-1 rounded-md text-xs font-mono font-bold border ${getCategoryColor(featured.category)}`}>
                  {featured.category.toUpperCase()}
                </span>
                <span class="font-mono text-xs text-[var(--color-ink-tertiary)] font-bold">
                  {featured.publishedAt} · {featured.readTime}
                </span>
              </div>

              <h3 class="text-3xl md:text-5xl font-serif font-bold text-white leading-tight group-hover:text-[#2ED3FE] transition-colors">
                <a href={`/blogs/${featured.slug}`}>
                  {featured.title}
                </a>
              </h3>

              <p class="mt-4 text-base md:text-lg text-[var(--color-ink-secondary)] leading-relaxed">
                {featured.summary}
              </p>

              <div class="mt-6 flex flex-wrap gap-2">
                {featured.tags.map((tag) => (
                  <span class="badge bg-white/5 text-xs font-mono border border-white/10 text-stone-300">
                    #{tag}
                  </span>
                ))}
              </div>

              <div class="mt-8 pt-6 border-t border-white/10 flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#2ED3FE] to-[#8B5CF6] p-0.5 shadow-[0_0_15px_rgba(46,211,254,0.25)]">
                    <div class="w-full h-full rounded-full bg-[#0B0F19] flex items-center justify-center font-serif font-bold text-lg text-white">
                      {featured.author.name.charAt(0)}
                    </div>
                  </div>
                  <div>
                    <div class="font-bold text-sm text-white">{featured.author.name}</div>
                    <div class="text-xs text-[#2ED3FE] font-mono font-semibold">{featured.author.role}</div>
                  </div>
                </div>

                <a href={`/blogs/${featured.slug}`} class="btn btn-primary text-xs font-mono py-2.5 px-6">
                  <span>Read Full Essay</span>
                  <span>→</span>
                </a>
              </div>
            </div>

            <div class="lg:col-span-5 flex justify-center">
              <JournalDiagram category={featured.category} slug={featured.slug} className="w-full shadow-2xl" />
            </div>
          </div>
        </article>
      </ScrollReveal>
    </div>
  </section>

  <!-- 3. CHRONOLOGICAL DISPATCHES ARCHIVE -->
  <section class="section pt-0 pb-16">
    <div class="container">
      <ScrollReveal animation="fade-up">
        <div class="border-b border-white/10 pb-4 mb-8 flex items-center justify-between">
          <div>
            <span class="section-label">EDITORIAL ARCHIVE</span>
            <h2 class="text-3xl font-serif font-bold mt-1 text-white">All Dispatches</h2>
          </div>
          <span class="font-mono text-xs text-[var(--color-ink-tertiary)]">
            {regularPosts.length} ADDITIONAL ESSAYS
          </span>
        </div>
      </ScrollReveal>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {regularPosts.map((post, idx) => (
          <ScrollReveal animation="fade-up" delay={idx * 80}>
            <article class="card p-8 flex flex-col justify-between bg-[#0E131F]/70 border border-white/10 rounded-2xl backdrop-blur-xl hover:border-[#2ED3FE]/50 transition-all duration-300 shadow-lg hover:shadow-[0_0_25px_rgba(46,211,254,0.15)] h-full group">
              <div>
                <!-- Editorial Technical Diagram Artwork -->
                <JournalDiagram category={post.category} slug={post.slug} className="mb-4" />

                <div class="flex items-center justify-between text-xs font-mono mb-4">
                  <span class={`px-2 py-0.5 rounded font-bold border text-[10px] ${getCategoryColor(post.category)}`}>
                    {post.category}
                  </span>
                  <span class="text-[var(--color-ink-tertiary)]">{post.publishedAt} · {post.readTime}</span>
                </div>

                <h3 class="text-2xl font-serif font-bold text-white leading-snug group-hover:text-[#2ED3FE] transition-colors">
                  <a href={`/blogs/${post.slug}`}>
                    {post.title}
                  </a>
                </h3>

                <p class="mt-3 text-sm text-[var(--color-ink-secondary)] leading-relaxed line-clamp-3">
                  {post.summary}
                </p>

                <div class="mt-4 flex flex-wrap gap-1.5">
                  {post.tags.map((tag) => (
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-white/5 border border-white/10 text-stone-300">
                      #{tag}
                    </span>
                  ))}
                </div>
              </div>

              <div class="mt-8 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono">
                <span class="text-stone-300 font-bold">{post.author.name}</span>
                <a href={`/blogs/${post.slug}`} class="font-bold text-[#2ED3FE] hover:underline flex items-center gap-1">
                  <span>Read Article</span>
                  <span>→</span>
                </a>
              </div>
            </article>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
