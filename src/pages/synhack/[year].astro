---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { synhackEditions, type SynHackEdition } from '../../data/synhack';
import ScrollReveal from '../../components/motion/ScrollReveal.astro';

export function getStaticPaths() {
  return synhackEditions.map((edition) => ({
    params: { year: edition.year },
    props: { edition },
  }));
}

interface Props {
  edition: SynHackEdition;
}

const { edition } = Astro.props;
---

<BaseLayout
  title={`${edition.edition} Archive | SyntaX VNIT`}
  description={`Official archive of ${edition.edition} at VNIT Nagpur — results, highlights, and winning prototypes.`}
>
  <article class="section pt-8 pb-16">
    <div class="container max-w-4xl">
      <!-- Breadcrumb -->
      <ScrollReveal animation="fade-up" delay={50}>
        <nav class="mb-6 font-mono text-xs text-[var(--color-ink-tertiary)] flex items-center gap-2" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/synhack" class="hover:text-white transition-colors">SynHack</a>
          <span>/</span>
          <span class="text-[#2ED3FE] font-bold">{edition.edition}</span>
        </nav>
      </ScrollReveal>

      <!-- Edition Header Card -->
      <ScrollReveal animation="fade-up" delay={150}>
        <div class="card p-8 md:p-10 bg-[#0E131F]/80 border border-white/10 rounded-2xl backdrop-blur-xl shadow-2xl relative overflow-hidden">
          <div class="absolute -top-24 -right-24 w-80 h-80 bg-gradient-to-br from-[#2ED3FE]/10 to-[#8B5CF6]/15 rounded-full blur-3xl pointer-events-none"></div>

          <div class="flex flex-wrap items-center gap-2 mb-3 relative z-10">
            <span class="badge badge-brand shadow-[0_0_12px_rgba(46,211,254,0.25)]">{edition.edition}</span>
            <span class="badge font-mono bg-white/5 border border-white/10 text-stone-300">{edition.dates}</span>
            <span class="badge bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 font-mono">
              {edition.status.toUpperCase()}
            </span>
          </div>

          <h1 class="text-3xl md:text-5xl font-serif font-bold text-white leading-tight relative z-10">
            {edition.edition}: <span class="text-gradient">{edition.theme}</span>
          </h1>

          <p class="mt-3 text-xl font-serif italic text-purple-300 relative z-10">
            "{edition.tagline}"
          </p>

          <p class="mt-5 text-base text-[var(--color-ink-secondary)] leading-relaxed relative z-10">
            {edition.overview}
          </p>

          <div class="mt-8 pt-6 border-t border-white/10 grid grid-cols-2 sm:grid-cols-4 gap-4 text-center font-mono relative z-10">
            <div class="p-3.5 bg-white/[0.03] rounded-xl border border-white/5">
              <div class="text-xs text-[var(--color-ink-tertiary)]">Duration</div>
              <div class="text-lg font-bold text-white mt-1">{edition.durationHours} hrs</div>
            </div>
            <div class="p-3.5 bg-white/[0.03] rounded-xl border border-white/5">
              <div class="text-xs text-[var(--color-ink-tertiary)]">Participation</div>
              <div class="text-lg font-bold text-white mt-1">{edition.expectedHackerCount}+</div>
            </div>
            <div class="p-3.5 bg-white/[0.03] rounded-xl border border-white/5">
              <div class="text-xs text-[var(--color-ink-tertiary)]">Prize Pool</div>
              <div class="text-lg font-bold text-[#2ED3FE] mt-1">{edition.prizePool.split(' ')[0]}</div>
            </div>
            <div class="p-3.5 bg-white/[0.03] rounded-xl border border-white/5">
              <div class="text-xs text-[var(--color-ink-tertiary)]">Venue</div>
              <div class="text-xs font-bold text-white mt-2">VNIT Nagpur</div>
            </div>
          </div>
        </div>
      </ScrollReveal>

      <!-- Winning Teams & Results Archive (if completed) -->
      {edition.winners && edition.winners.length > 0 && (
        <section class="mt-12">
          <ScrollReveal animation="fade-up">
            <span class="section-label">PODIUM FINISHERS</span>
            <h2 class="text-3xl font-serif font-bold mb-6 text-white">Winning Solutions & Teams</h2>
          </ScrollReveal>

          <div class="space-y-6">
            {edition.winners.map((win, idx) => (
              <ScrollReveal animation="fade-up" delay={idx * 80}>
                <div class="card p-6 md:p-8 bg-[#0E131F]/70 border border-white/10 rounded-2xl backdrop-blur-xl hover:border-[#2ED3FE]/50 transition-all shadow-xl group">
                  <div class="flex items-center justify-between text-xs font-mono mb-2">
                    <span class="badge badge-brand shadow-[0_0_10px_rgba(46,211,254,0.2)]">{win.track}</span>
                    <span class="text-[var(--color-ink-tertiary)] font-bold">Team: {win.teamName}</span>
                  </div>

                  <h3 class="text-2xl font-serif font-bold text-white group-hover:text-[#2ED3FE] transition-colors">
                    {win.projectTitle}
                  </h3>

                  <p class="mt-2 text-sm text-[var(--color-ink-secondary)] leading-relaxed">
                    {win.description}
                  </p>

                  <div class="mt-4 pt-3 border-t border-white/10 text-xs font-mono text-[var(--color-ink-secondary)] flex items-center gap-2">
                    <span class="text-[var(--color-ink-tertiary)]">Engineers:</span>
                    <span class="font-bold text-stone-200">{win.members.join(', ')}</span>
                  </div>
                </div>
              </ScrollReveal>
            ))}
          </div>
        </section>
      )}

      <!-- Tracks in this edition -->
      <section class="mt-12">
        <ScrollReveal animation="fade-up">
          <span class="section-label">CHALLENGE DOMAINS</span>
          <h2 class="text-2xl font-serif font-bold mb-6 text-white">Edition Tracks</h2>
        </ScrollReveal>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {edition.tracks.map((t, idx) => (
            <ScrollReveal animation="fade-up" delay={idx * 60}>
              <div class="card p-6 bg-[#0E131F]/60 border border-white/10 rounded-2xl backdrop-blur-xl h-full">
                <h3 class="font-bold text-lg font-serif text-white">{t.title}</h3>
                <p class="mt-2 text-xs text-[var(--color-ink-secondary)] leading-relaxed">
                  {t.description}
                </p>
              </div>
            </ScrollReveal>
          ))}
        </div>
      </section>

      <ScrollReveal animation="fade-up" delay={200}>
        <div class="mt-12 text-center">
          <a href="/synhack" class="btn btn-secondary font-mono text-xs py-2.5 px-6">
            ← Back to SynHack Overview
          </a>
        </div>
      </ScrollReveal>
    </div>
  </article>
</BaseLayout>
