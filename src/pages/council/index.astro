---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { councilYears, getCurrentCouncil, getEnrichedCouncil } from '../../data/council';
import ScrollReveal from '../../components/motion/ScrollReveal.astro';
import Ticker from '../../components/motion/Ticker.astro';
import FramingCrosshair from '../../components/illustrations/FramingCrosshair.astro';

const currentCouncil = getCurrentCouncil();
const enrichedCurrent = getEnrichedCouncil(currentCouncil);
const historicalCouncils = councilYears.filter((c) => !c.isCurrent);
---

<BaseLayout
  title="Council & People Archive | SyntaX VNIT"
  description="Meet the current student council and explore historical leadership records of SyntaX VNIT across academic years."
>
  <!-- 1. HEADER SECTION -->
  <section class="section pt-8 pb-12">
    <div class="container">
      <div class="max-w-3xl space-y-4">
        <ScrollReveal animation="fade-up" delay={100}>
          <div class="inline-flex items-center gap-2 p-1.5 pr-4 rounded-full bg-white/[0.04] border border-white/10 backdrop-blur-md">
            <span class="badge badge-brand text-[10px]">STUDENT GOVERNANCE</span>
            <span class="font-mono text-xs text-slate-400">VNIT NAGPUR</span>
          </div>
        </ScrollReveal>

        <ScrollReveal animation="fade-up" delay={200}>
          <h1 class="text-4xl sm:text-6xl font-extrabold text-white leading-tight">
            The Council <span class="text-gradient">Archive.</span>
          </h1>
        </ScrollReveal>

        <ScrollReveal animation="fade-up" delay={300}>
          <p class="text-lg md:text-xl text-slate-300 leading-relaxed font-normal">
            SyntaX is steered entirely by undergraduate engineers at VNIT Nagpur. Every academic year brings a new council entrusted with directing technical tracks and mentoring junior cohorts.
          </p>
        </ScrollReveal>

        <!-- Academic Year Navigation Pills -->
        <ScrollReveal animation="fade-up" delay={400}>
          <div class="pt-4 flex flex-wrap items-center gap-2">
            <span class="font-mono text-xs text-slate-400 mr-1 font-bold">SESSIONS:</span>
            {councilYears.map((c) => (
              <a
                href={`#council-${c.academicYear}`}
                class={`px-3 py-1.5 rounded-full text-xs font-mono border transition-all ${
                  c.isCurrent
                    ? 'bg-cyan-500/20 text-cyan-300 border-cyan-500/40 shadow-sm'
                    : 'bg-white/[0.04] text-slate-400 border-white/10 hover:border-white/30 hover:text-white'
                }`}
              >
                {c.academicYear} {c.isCurrent ? '(Current)' : ''}
              </a>
            ))}
          </div>
        </ScrollReveal>
      </div>
    </div>
  </section>

  <!-- TICKER -->
  <Ticker
    items={['President', 'Vice President', 'Web Systems Lead', 'Competitive Programming Lead', 'AI & Research Lead', 'Design Lead', 'Annual Handover']}
    speed={35}
    variant="default"
  />

  <!-- 2. CURRENT COUNCIL SHOWCASE (PROMINENT) -->
  <section id={`council-${currentCouncil.academicYear}`} class="section pt-10 pb-16">
    <div class="container">
      <ScrollReveal animation="fade-up">
        <div class="p-8 md:p-12 rounded-3xl bg-gradient-to-br from-[#0F172A] via-[#101930] to-[#18112C] border-2 border-cyan-500/30 mb-12 shadow-2xl">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 border-b border-white/10 pb-8 mb-8">
            <div>
              <div class="flex items-center gap-3">
                <span class="badge badge-brand text-[11px]">ACTIVE COUNCIL</span>
                <span class="font-mono text-xs text-cyan-400 font-bold">{currentCouncil.tenure}</span>
              </div>
              <h2 class="text-3xl md:text-5xl font-extrabold text-white mt-2">
                Academic Year {currentCouncil.academicYear}
              </h2>
              {currentCouncil.theme && (
                <p class="font-serif italic text-lg text-purple-400 mt-1">
                  Theme: "{currentCouncil.theme}"
                </p>
              )}
            </div>
            <p class="max-w-md text-sm text-slate-300 leading-relaxed">
              {currentCouncil.summary}
            </p>
          </div>

          <!-- Members Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {enrichedCurrent.map(({ person, role, category }, i) => (
              <ScrollReveal animation="fade-up" delay={i * 80}>
                <div class="card p-6 flex flex-col justify-between h-full hover:border-cyan-400/50 bg-[#0B0F19]/80 relative overflow-hidden group">
                  <FramingCrosshair color="#2ED3FE" />
                  <div>
                    <!-- Glowing Avatar -->
                    <div class="w-16 h-16 rounded-full bg-gradient-to-br from-cyan-400 to-purple-600 p-0.5 mb-4 shadow-md">
                      <div class="w-full h-full rounded-full bg-[#0B0F19] flex items-center justify-center font-bold text-xl text-white">
                        {person.name.split(' ').map((n) => n[0]).join('')}
                      </div>
                    </div>

                    <span class="badge text-[10px] font-mono mb-2">{category}</span>
                    <h3 class="text-xl font-bold text-white">
                      <a href={`/people/${person.slug}`} class="hover:text-cyan-400 transition-colors">
                        {person.name}
                      </a>
                    </h3>
                    <div class="text-xs font-mono font-bold text-cyan-400 mt-1">
                      {role}
                    </div>
                    <div class="text-xs text-slate-400 font-mono mt-0.5">
                      {person.department} ('{person.batch?.slice(-2)})
                    </div>
                    <p class="mt-3 text-xs text-slate-400 leading-relaxed line-clamp-3">
                      {person.bio}
                    </p>
                  </div>

                  <div class="mt-5 pt-3 border-t border-white/5 flex items-center justify-between">
                    <a
                      href={`/people/${person.slug}`}
                      class="text-xs font-mono font-bold text-cyan-400 hover:underline flex items-center gap-1"
                    >
                      <span>Bio & Work</span>
                      <span>→</span>
                    </a>

                    <div class="flex items-center gap-2">
                      {person.socials.github && (
                        <a
                          href={person.socials.github}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-slate-400 hover:text-cyan-400 p-1"
                          aria-label={`${person.name}'s GitHub`}
                        >
                          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                        </a>
                      )}
                      {person.socials.linkedin && (
                        <a
                          href={person.socials.linkedin}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-slate-400 hover:text-cyan-400 p-1"
                          aria-label={`${person.name}'s LinkedIn`}
                        >
                          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </ScrollReveal>
            ))}
          </div>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- 3. HISTORICAL COUNCILS ARCHIVE -->
  <section class="section pt-0 pb-16">
    <div class="container space-y-12">
      <ScrollReveal animation="fade-up">
        <div class="border-b border-white/10 pb-4">
          <span class="section-label">CHRONICLES & FOUNDATIONS</span>
          <h2 class="text-2xl md:text-4xl font-extrabold text-white mt-1">Historical Councils Archive</h2>
        </div>
      </ScrollReveal>

      {historicalCouncils.map((council) => {
        const enriched = getEnrichedCouncil(council);
        return (
          <ScrollReveal animation="fade-up">
            <div id={`council-${council.academicYear}`} class="card p-8 md:p-10 hover:border-cyan-400/40 transition-all">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-white/10 pb-6 mb-8">
                <div>
                  <span class="badge text-xs font-mono">{council.tenure}</span>
                  <h3 class="text-2xl md:text-3xl font-extrabold text-white mt-1">
                    Academic Year {council.academicYear}
                  </h3>
                  {council.theme && (
                    <p class="font-serif italic text-sm text-purple-400 mt-0.5">
                      Theme: "{council.theme}"
                    </p>
                  )}
                </div>
                <div class="flex items-center gap-4">
                  <p class="max-w-md text-xs text-slate-400 leading-relaxed">
                    {council.summary}
                  </p>
                  <a
                    href={`/council/${council.academicYear}`}
                    class="btn btn-secondary text-xs font-mono py-2 px-4 shrink-0"
                  >
                    Dedicated Year Page →
                  </a>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                {enriched.map(({ person, role }) => (
                  <div class="p-5 rounded-xl bg-white/[0.02] border border-white/5 flex flex-col justify-between hover:border-cyan-400/40 transition-all">
                    <div>
                      <h4 class="font-bold text-base text-white">
                        <a href={`/people/${person.slug}`} class="hover:text-cyan-400 transition-colors">
                          {person.name}
                        </a>
                      </h4>
                      <div class="text-xs font-mono text-cyan-400 font-semibold mt-1">
                        {role}
                      </div>
                      <div class="text-xs font-mono text-slate-500 mt-0.5">
                        Batch of {person.batch}
                      </div>
                    </div>
                    <a
                      href={`/people/${person.slug}`}
                      class="mt-4 text-xs font-mono font-bold text-white hover:text-cyan-400 flex items-center gap-1"
                    >
                      <span>Member Profile</span>
                      <span>→</span>
                    </a>
                  </div>
                ))}
              </div>
            </div>
          </ScrollReveal>
        );
      })}
    </div>
  </section>
</BaseLayout>
