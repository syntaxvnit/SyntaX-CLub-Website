---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { councilYears, getEnrichedCouncil, type CouncilYear } from '../../data/council';
import ScrollReveal from '../../components/motion/ScrollReveal.astro';

export function getStaticPaths() {
  return councilYears.map((council) => ({
    params: { year: council.academicYear },
    props: { council },
  }));
}

interface Props {
  council: CouncilYear;
}

const { council } = Astro.props;
const enrichedMembers = getEnrichedCouncil(council);
---

<BaseLayout
  title={`Council ${council.academicYear} | SyntaX VNIT`}
  description={`Leadership archive and elected student council for academic session ${council.academicYear} at SyntaX VNIT.`}
>
  <section class="section pt-8 pb-16">
    <div class="container">
      <!-- Breadcrumb -->
      <ScrollReveal animation="fade-up" delay={50}>
        <nav class="mb-6 font-mono text-xs text-[var(--color-ink-tertiary)] flex items-center gap-2" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/council" class="hover:text-white transition-colors">Council</a>
          <span>/</span>
          <span class="text-[#2ED3FE] font-bold">{council.academicYear}</span>
        </nav>
      </ScrollReveal>

      <ScrollReveal animation="fade-up" delay={150}>
        <div class="max-w-3xl mb-12">
          <div class="flex items-center gap-3 mb-2">
            <span class={`badge ${council.isCurrent ? 'badge-brand shadow-[0_0_12px_rgba(46,211,254,0.3)]' : 'bg-white/5 border border-white/10 text-stone-300'}`}>
              {council.isCurrent ? 'ACTIVE COUNCIL' : 'HISTORICAL TENURE'}
            </span>
            <span class="font-mono text-xs text-[var(--color-ink-tertiary)] font-bold">{council.tenure}</span>
          </div>
          <h1 class="text-4xl lg:text-6xl font-serif font-bold text-white tracking-tight">
            Council <span class="text-gradient">{council.academicYear}</span>
          </h1>
          {council.theme && (
            <p class="font-serif italic text-xl text-purple-300 mt-2">
              Theme: "{council.theme}"
            </p>
          )}
          <p class="mt-4 text-lg text-[var(--color-ink-secondary)] leading-relaxed">
            {council.summary}
          </p>
        </div>
      </ScrollReveal>

      <!-- Members Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {enrichedMembers.map(({ person, role, category }, idx) => (
          <ScrollReveal animation="fade-up" delay={idx * 50}>
            <div class="card p-6 flex flex-col justify-between bg-[#0E131F]/70 border border-white/10 rounded-2xl backdrop-blur-xl hover:border-[#2ED3FE]/50 transition-all duration-300 shadow-lg hover:shadow-[0_0_25px_rgba(46,211,254,0.15)] h-full group">
              <div>
                <div class="w-16 h-16 rounded-full bg-gradient-to-br from-[#2ED3FE] to-[#8B5CF6] p-0.5 mb-4 shadow-[0_0_15px_rgba(46,211,254,0.25)] group-hover:scale-105 transition-transform duration-300">
                  <div class="w-full h-full rounded-full bg-[#0B0F19] flex items-center justify-center font-serif font-bold text-xl text-white">
                    {person.name.split(' ').map((n) => n[0]).join('')}
                  </div>
                </div>
                <span class="badge text-[10px] uppercase font-mono mb-2 bg-white/5 border border-white/10 text-[#2ED3FE]">{category}</span>
                <h3 class="text-xl font-serif font-bold text-white group-hover:text-[#2ED3FE] transition-colors">
                  <a href={`/people/${person.slug}`}>
                    {person.name}
                  </a>
                </h3>
                <div class="text-xs font-mono font-bold text-[#2ED3FE] mt-1">
                  {role}
                </div>
                <div class="text-xs text-[var(--color-ink-tertiary)] font-mono mt-0.5">
                  Batch of {person.batch}
                </div>
                <p class="mt-3 text-xs text-[var(--color-ink-secondary)] line-clamp-3 leading-relaxed">
                  {person.bio}
                </p>
              </div>

              <div class="mt-6 pt-3 border-t border-white/10 flex items-center justify-between">
                <a href={`/people/${person.slug}`} class="text-xs font-mono font-bold text-white hover:text-[#2ED3FE] transition-colors flex items-center gap-1">
                  <span>Profile</span>
                  <span>→</span>
                </a>
                <div class="flex items-center gap-2">
                  {person.socials.github && (
                    <a
                      href={person.socials.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[var(--color-ink-secondary)] hover:text-[#2ED3FE] transition-colors p-1"
                      aria-label={`${person.name}'s GitHub`}
                    >
                      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                    </a>
                  )}
                  {person.socials.linkedin && (
                    <a
                      href={person.socials.linkedin}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[var(--color-ink-secondary)] hover:text-[#2ED3FE] transition-colors p-1"
                      aria-label={`${person.name}'s LinkedIn`}
                    >
                      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </ScrollReveal>
        ))}
      </div>

      <ScrollReveal animation="fade-up" delay={200}>
        <div class="mt-12 pt-8 border-t border-white/10 flex items-center justify-between">
          <a href="/council" class="btn btn-secondary font-mono text-xs py-2.5 px-6">
            ← Back to Council Archive
          </a>
        </div>
      </ScrollReveal>
    </div>
  </section>
</BaseLayout>
